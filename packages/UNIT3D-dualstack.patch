@@ -0,0 +1,37 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\DB;
+
+final class PeerCountPreference
+{
+    /** Um lote de usuarios; nenhuma consulta ou escrita por peer. */
+    public function resolve(array $userIds): int
+    {
+        if (!config('dualstack.enabled') || $userIds === []) {
+            return 0;
+        }
+
+        $activity = DB::table('peer_ips as endpoints')
+            ->join('peers', fn ($join) => $join
+                ->on('peers.user_id', '=', 'endpoints.user_id')
+                ->on('peers.torrent_id', '=', 'endpoints.torrent_id')
+                ->on('peers.peer_id', '=', 'endpoints.peer_id'))
+            ->whereIn('peers.user_id', $userIds)
+            ->where('peers.active', true)
+            ->where('endpoints.last_announced_at', '>', now()->subSeconds((int) config('dualstack.endpoint_ttl')))
+            ->select('peers.user_id')
+            ->selectRaw('BIT_OR(IF(peers.seeder, IF(endpoints.family = 4, 1, 2), 0)) AS seeding_families')
+            ->selectRaw('BIT_OR(IF(endpoints.family = 4, 1, 2)) AS active_families')
+            ->groupBy('peers.user_id');
+
+        return DB::transaction(fn () => DB::table('users')
+            ->leftJoinSub($activity, 'activity', fn ($join) => $join->on('activity.user_id', '=', 'users.id'))
+            ->whereIn('users.id', $userIds)
+            ->where('users.peer_count_mode', 'auto')
+            ->update(['users.peer_count_auto_mode' => DB::raw("CASE COALESCE(NULLIF(activity.seeding_families, 0), activity.active_families, 0) WHEN 1 THEN 'ipv4' WHEN 2 THEN 'ipv6' ELSE 'sum' END")]), 5);
+    }
+}
diff --git a/app/Services/Dualstack/PeerSearchQuery.php b/app/Services/Dualstack/PeerSearchQuery.php
new file mode 100644
index 0000000000000000000000000000000000000000..1cf07dfefc14b072fcfb5b312d4fb6fc43570049
--- /dev/null
+++ b/app/Services/Dualstack/PeerSearchQuery.php
@@ -0,0 +1,135 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use App\Models\Peer;
+use Illuminate\Pagination\LengthAwarePaginator;
+use Illuminate\Support\Facades\DB;
+
+final class PeerSearchQuery
+{
+    public static function paginate(array $filters): LengthAwarePaginator
+    {
+        $cutoff = now()->subSeconds((int) config('dualstack.endpoint_ttl'))->format('Y-m-d H:i:s');
+        $network = DB::table('peer_ips')->select(['user_id','torrent_id','peer_id'])
+            ->selectRaw('MAX(last_announced_at > ?) AS live', [$cutoff])
+            ->selectRaw('MAX(last_announced_at > ? AND connectable=1) AS positive', [$cutoff])
+            ->selectRaw('MAX(last_announced_at > ? AND connectable IS NULL) AS unknown', [$cutoff])
+            ->selectRaw('MIN(INET6_NTOA(ip)) AS ip, MIN(port) AS port')
+            ->groupBy(['user_id','torrent_id','peer_id']);
+        $rows = DB::table('peers as p')->join('torrents as t', 't.id', '=', 'p.torrent_id')
+            ->whereNull('t.deleted_at')
+            ->whereExists(fn ($q) => $q->selectRaw('1')->from('users as u')->whereColumn('u.id', 'p.user_id')->whereNull('u.deleted_at'))
+            ->leftJoinSub($network, 'network', fn ($join) => self::joinIdentity($join, 'network', 'p'))
+            ->select(['p.user_id','p.torrent_id','p.peer_id','p.agent','p.uploaded','p.downloaded','p.left','p.seeder','p.visible','p.created_at','p.updated_at','t.size','network.ip','network.port'])
+            ->selectRaw('p.active AND COALESCE(network.live,0) AS active')
+            ->selectRaw('CASE WHEN network.positive=1 THEN 1 WHEN COALESCE(network.live,0)=0 OR network.unknown=1 THEN NULL ELSE 0 END AS connectable');
+        $logical = Peer::query()->fromSub($rows, 'peers');
+
+        if ($filters['ip'] !== '' || $filters['port'] !== '' || $filters['sharedIpsOnly'] || $filters['sharedSocketsOnly']) {
+            $matching = DB::table('peer_ips as e')->selectRaw('1')->whereColumn('e.user_id', 'peers.user_id')
+                ->whereColumn('e.torrent_id', 'peers.torrent_id')->whereColumn('e.peer_id', 'peers.peer_id');
+            self::matchEndpoints($matching, $filters);
+            $logical->whereExists($matching);
+        }
+        $logical->when($filters['agent'] !== '', fn ($q) => $q->where('peers.agent', 'LIKE', $filters['agent'].'%'))
+            ->when($filters['torrent'] !== '', fn ($q) => $q->whereRelation('torrent', 'name', 'LIKE', '%'.str_replace(' ', '%', $filters['torrent']).'%'))
+            ->when($filters['connectivity'] === 'connectable', fn ($q) => $q->where('peers.connectable', true))
+            ->when($filters['connectivity'] === 'unconnectable', fn ($q) => $q->where('peers.connectable', false))
+            ->when($filters['connectivity'] === 'unknown', fn ($q) => $q->whereNull('peers.connectable'))
+            ->when($filters['active'] === 'include', fn ($q) => $q->where('peers.active', true))
+            ->when($filters['active'] === 'exclude', fn ($q) => $q->where('peers.active', false));
+        $mode = \in_array($filters['groupBy'], ['user','user_ip','user_session'], true) ? $filters['groupBy'] : 'none';
+
+        if ($mode === 'none') {
+            $query = (clone $logical)->select('peers.*')->with(['user.group','torrent:id,name,size']);
+        } else {
+            $group = (clone $logical)->select('peers.user_id')->groupBy('peers.user_id');
+
+            if ($mode === 'user_ip') {
+                // Uma linha por peer e endereco; familias distintas formam grupos distintos.
+                $group->join('peer_ips as e', fn ($join) => self::joinIdentity($join, 'e', 'peers'))
+                    ->groupBy('e.ip')->selectRaw('INET6_NTOA(e.ip) AS ip, COUNT(DISTINCT e.port) AS port');
+                self::matchEndpoints($group, $filters);
+            } elseif ($mode === 'user_session') {
+                $group->addSelect(['peers.agent','peers.peer_id'])->groupBy(['peers.agent','peers.peer_id']);
+            }
+
+            if ($mode !== 'user_session') {
+                $group->selectRaw('COUNT(DISTINCT peers.agent) AS agent');
+            }
+            $group->selectRaw('COUNT(*) AS peer_count, COUNT(DISTINCT peers.torrent_id) AS torrent_id')
+                ->selectRaw('SUM(peers.uploaded) AS uploaded, SUM(peers.downloaded) AS downloaded, SUM(peers.`left`) AS `left`')
+                ->selectRaw('MIN(peers.created_at) AS created_at, MAX(peers.updated_at) AS updated_at')
+                ->selectRaw('COALESCE(SUM(peers.connectable=1),0) AS connectable_count, COALESCE(SUM(peers.connectable=0),0) AS unconnectable_count, SUM(peers.connectable IS NULL) AS unknown_count')
+                ->selectRaw('SUM(peers.active=1) AS active_count, SUM(peers.active=0) AS inactive_count')
+                ->selectRaw('ROUND(COALESCE(SUM(peers.active=0)/NULLIF(SUM(peers.active=1),0),0),2) AS inactive_ratio')
+                ->selectRaw('SUM(peers.size) AS size, SUM(CASE WHEN peers.connectable=1 THEN peers.size ELSE 0 END) AS connectable_size, SUM(CASE WHEN peers.connectable=0 THEN peers.size ELSE 0 END) AS unconnectable_size');
+            $query = Peer::query()->fromSub($group->toBase(), 'peers')->select('peers.*')->with('user.group');
+
+            if ($mode !== 'user_ip') {
+                $endpoints = DB::table('peer_ips as e')->joinSub((clone $logical)->select('peers.*')->toBase(), 'matched', fn ($join) => self::joinIdentity($join, 'e', 'matched'))
+                    ->whereColumn('e.user_id', 'peers.user_id');
+
+                if ($mode === 'user_session') {
+                    $endpoints->whereColumn('matched.agent', 'peers.agent')->whereColumn('matched.peer_id', 'peers.peer_id');
+                }
+                $query->addSelect(['ip' => (clone $endpoints)->selectRaw('COUNT(DISTINCT e.ip)'),
+                    'port'              => (clone $endpoints)->selectRaw('COUNT(DISTINCT e.port)')]);
+            }
+        }
+        $allowed = ['peers.user_id','user_id','torrent_id','agent','ip','port','uploaded','downloaded','left','created_at','updated_at','size'];
+        $allowed = array_merge($allowed, $mode === 'none' ? ['active','connectable'] : ['peer_count','connectable_count','unconnectable_count','unknown_count','active_count','inactive_count','inactive_ratio','connectable_size','unconnectable_size']);
+        $sort = \in_array($filters['sortField'], $allowed, true) ? $filters['sortField'] : 'created_at';
+        $query->orderBy($sort, $filters['sortDirection'] === 'asc' ? 'asc' : 'desc')->orderBy('peers.user_id');
+
+        if ($mode === 'none') {
+            $query->orderBy('peers.torrent_id')->orderBy('peers.peer_id');
+        }
+
+        if ($mode === 'user_ip') {
+            $query->orderBy('ip');
+        }
+
+        if ($mode === 'user_session') {
+            $query->orderBy('peers.agent')->orderBy('peers.peer_id');
+        }
+        $page = $query->paginate(min(100, max(1, (int) $filters['perPage'])));
+
+        if ($mode === 'none') {
+            EndpointView::load($page->getCollection());
+        }
+
+        if ($mode === 'user_session') {
+            $page->getCollection()->each(fn ($peer) => $peer->makeHidden('peer_id'));
+        }
+
+        return $page;
+    }
+
+    private static function joinIdentity($join, string $left, string $right): void
+    {
+        foreach (['user_id','torrent_id','peer_id'] as $column) {
+            $join->on($left.'.'.$column, '=', $right.'.'.$column);
+        }
+    }
+
+    private static function matchEndpoints($query, array $filters): void
+    {
+        if ($filters['ip'] !== '') {
+            $query->where(fn ($q) => $q->whereRaw('INET6_NTOA(e.ip) LIKE ?', [$filters['ip'].'%'])
+                ->orWhereRaw('e.ip=INET6_ATON(?)', [$filters['ip']]));
+        }
+        $query->when($filters['port'] !== '', fn ($q) => $q->where('e.port', 'LIKE', $filters['port']));
+
+        if ($filters['sharedIpsOnly']) {
+            $query->whereIn('e.ip', DB::table('peer_ips')->select('ip')->groupBy('ip')->havingRaw('COUNT(DISTINCT user_id)>1'));
+        }
+
+        if ($filters['sharedSocketsOnly']) {
+            $query->whereIn(DB::raw('(e.ip,e.port)'),DB::table('peer_ips')->select(['ip','port'])->groupBy(['ip','port'])->havingRaw('COUNT(DISTINCT user_id)>1'));
+        }
+    }
+}
diff --git a/app/Services/Dualstack/PeerTransition.php b/app/Services/Dualstack/PeerTransition.php
new file mode 100644
index 0000000000000000000000000000000000000000..7969f090734a7a61f387a8b6a41a535b03b6b307
--- /dev/null
+++ b/app/Services/Dualstack/PeerTransition.php
@@ -0,0 +1,212 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use InvalidArgumentException;
+
+/** Funcao de transicao pura. A referencia so avanca quando o CAS aceita o resultado. */
+final class PeerTransition
+{
+    public static function apply(?array $before, array $request, array $policy): array
+    {
+        $ttl = (int) $policy['endpoint_ttl'];
+        $maxEndpoints = (int) $policy['max_endpoints'];
+        $minInterval = (int) $policy['min_interval'];
+
+        if ($ttl < 1 || !\in_array($maxEndpoints, [1, 2], true) || $minInterval < 0) {
+            throw new InvalidArgumentException('Configuracao dualstack invalida.');
+        }
+        $kind = $request['kind'] ?? 'announce';
+
+        if (!\in_array($kind, ['announce', 'expire', 'probe', 'flush'], true)) {
+            throw new InvalidArgumentException('Operacao de peer invalida.');
+        }
+        $now = max((int) $request['at'], (int) ($before['updated_at'] ?? 0));
+        $version = (int) ($before['state_version'] ?? 0) + 1;
+        $state = $before;
+
+        if ($kind === 'flush') {
+            if (!isset($request['cutoff']) || !\is_int($request['cutoff']) || $request['cutoff'] > $now - 4200) {
+                throw new InvalidArgumentException('Corte de limpeza invalido.');
+            }
+
+            // Nunca inferir a elegibilidade pelo snapshot SQL do site: o CAS relera
+            // o endpoint corrente se um announce disputar esta transicao.
+            if ($state !== null) {
+                foreach ($state['endpoints'] as $family => $endpoint) {
+                    if ($endpoint['last_announced_at'] < $request['cutoff']) {
+                        unset($state['endpoints'][$family]);
+                    }
+                }
+            }
+
+            if ($state === null || $state['endpoints'] === $before['endpoints']) {
+                return self::result('ignored', $before);
+            }
+
+            return self::accepted($state, $version, $now);
+        }
+
+        if ($state !== null) {
+            foreach ($state['endpoints'] as $family => $endpoint) {
+                if ($endpoint['last_announced_at'] + $ttl <= $now) {
+                    unset($state['endpoints'][$family]);
+                }
+            }
+        }
+
+        if ($kind === 'probe') {
+            $ip = EndpointAddress::observed($request['ip'], (bool) ($policy['allow_private_addresses'] ?? false));
+            $endpoint = $state['endpoints'][$ip->family] ?? null;
+
+            if ($endpoint === null || $endpoint['ip'] !== $ip->text()
+                || $endpoint['port'] !== (int) $request['port']
+                || $endpoint['revision'] !== (int) $request['revision']
+                || $endpoint['last_announced_at'] + $ttl <= $now) {
+                return self::result('ignored', $before);
+            }
+            $state['endpoints'][$ip->family]['connectable'] = (bool) $request['connectable'];
+            $state['endpoints'][$ip->family]['connectivity_checked_at'] = $now;
+
+            return self::accepted($state, $version, $now);
+        }
+
+        if ($kind === 'expire') {
+            if ($state === null || $state['endpoints'] === $before['endpoints']) {
+                return self::result('ignored', $before);
+            }
+
+            return self::accepted($state, $version, $now);
+        }
+
+        $ip = EndpointAddress::observed($request['ip'], (bool) ($policy['allow_private_addresses'] ?? false));
+        $event = $request['event'];
+        $uploaded = Counter::of($request['uploaded']);
+        $downloaded = Counter::of($request['downloaded']);
+        $left = Counter::of($request['left']);
+        $port = (int) $request['port'];
+
+        if (!\in_array($event, ['', 'started', 'completed', 'stopped', 'paused'], true)
+            || $port < 0 || $port > 65535 || ($port < 1024 && $event !== 'stopped')) {
+            throw new InvalidArgumentException('Evento ou porta invalida.');
+        }
+        $endpoint = $state['endpoints'][$ip->family] ?? null;
+
+        if ($event === 'stopped' && ($endpoint === null || $endpoint['ip'] !== $ip->text())) {
+            return self::result('ignored', $before);
+        }
+        $newSession = $state === null || ($state['endpoints'] === [] && $event === 'started');
+
+        if (!$newSession && !\in_array($event, ['completed', 'stopped'], true)
+            && isset($state['last_announces'][$ip->family])
+            && $now - $state['last_announces'][$ip->family] < $minInterval) {
+            return self::result('rejected', $before, reason: 'interval');
+        }
+
+        if ($endpoint === null && $event !== 'stopped' && \count($state['endpoints'] ?? []) >= $maxEndpoints) {
+            return self::result('rejected', $before, reason: 'endpoint_limit');
+        }
+
+        $uploadDelta = $newSession ? '0' : Counter::delta($uploaded, $state['uploaded']);
+        $downloadDelta = $newSession ? '0' : Counter::delta($downloaded, $state['downloaded']);
+        $stale = !$newSession && (Counter::compare($downloaded, $state['downloaded']) < 0
+            || ($downloaded === $state['downloaded'] && Counter::compare($uploaded, $state['uploaded']) < 0));
+
+        if ($newSession) {
+            $state = [
+                'uploaded'            => $uploaded, 'downloaded' => $downloaded, 'left' => $left,
+                'agent'               => $request['agent'], 'visible' => (bool) $request['visible'],
+                'endpoints'           => [], 'last_announces' => [],
+                'session_generation'  => (int) ($before['session_generation'] ?? 0) + 1,
+                'completion_reported' => $left === '0',
+                'created_at'          => $before['created_at'] ?? $now, 'session_started_at' => $now,
+                'legacy_endpoint'     => $before['legacy_endpoint'] ?? null,
+            ];
+        } else {
+            $state['uploaded'] = Counter::maximum($state['uploaded'], $uploaded);
+            $state['downloaded'] = Counter::maximum($state['downloaded'], $downloaded);
+
+            if (!$stale) {
+                $state['left'] = $left;
+            }
+            $state['agent'] = $request['agent'];
+            $state['visible'] = (bool) $request['visible'];
+        }
+        $completed = !$newSession && !$stale && $event === 'completed' && $left === '0' && !$state['completion_reported'];
+        $state['completion_reported'] = $state['completion_reported'] || $completed;
+        $state['last_announces'][$ip->family] = $now;
+
+        if ($event === 'stopped') {
+            unset($state['endpoints'][$ip->family]);
+        } else {
+            if ($endpoint === null || $endpoint['ip'] !== $ip->text() || $endpoint['port'] !== $port) {
+                $endpoint = [
+                    'family'      => $ip->family, 'ip' => $ip->text(), 'port' => $port,
+                    'connectable' => null, 'connectivity_checked_at' => null,
+                    'revision'    => $version, 'created_at' => $now,
+                ];
+            }
+            $endpoint['last_announced_at'] = $now;
+            $state['endpoints'][$ip->family] = $endpoint;
+        }
+
+        return self::accepted($state, $version, $now, $uploadDelta, $downloadDelta, (int) $completed);
+    }
+
+    private static function accepted(array $state, int $version, int $now, string $uploadDelta = '0', string $downloadDelta = '0', int $completed = 0): array
+    {
+        ksort($state['endpoints']);
+        $state['state_version'] = $version;
+        $state['updated_at'] = $now;
+        $state['active'] = $state['endpoints'] !== [];
+        $state['seeder'] = $state['left'] === '0';
+        $state['connectable'] = false;
+
+        foreach ($state['endpoints'] as $endpoint) {
+            $state['connectable'] = $state['connectable'] || $endpoint['connectable'] === true;
+        }
+
+        if ($state['active']) {
+            $state['legacy_endpoint'] = reset($state['endpoints']);
+
+            foreach ($state['endpoints'] as $endpoint) {
+                if ($endpoint['connectable'] === true) {
+                    $state['legacy_endpoint'] = $endpoint;
+
+                    break;
+                }
+            }
+        }
+
+        return self::result('accepted', $state, $uploadDelta, $downloadDelta, $completed);
+    }
+
+    private static function result(string $outcome, ?array $state, string $uploadDelta = '0', string $downloadDelta = '0', int $completed = 0, ?string $reason = null): array
+    {
+        return ['outcome'  => $outcome, 'reason' => $reason, 'peer' => $state,
+            'upload_delta' => $uploadDelta, 'download_delta' => $downloadDelta, 'completed_delta' => $completed];
+    }
+
+    /** Contribuicao do snapshot persistido; a validade temporal e usada nas leituras. */
+    public static function counts(?array $state, bool $requireConnectivity, ?int $now = null, int $ttl = 7200): array
+    {
+        $counts = array_fill_keys(['seeders', 'leechers', 'seeders_ipv4', 'seeders_ipv6', 'leechers_ipv4', 'leechers_ipv6'], 0);
+
+        if ($state === null || !$state['active'] || !$state['visible']) {
+            return $counts;
+        }
+        $kind = $state['seeder'] ? 'seeders' : 'leechers';
+
+        foreach ($state['endpoints'] as $family => $endpoint) {
+            if (($now === null || $endpoint['last_announced_at'] + $ttl > $now)
+                && (!$requireConnectivity || $endpoint['connectable'] === true)) {
+                $counts[$kind] = 1;
+                $counts[$kind.'_ipv'.$family] = 1;
+            }
+        }
+
+        return $counts;
+    }
+}
