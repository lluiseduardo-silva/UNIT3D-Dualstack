+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+final class CleanupResponse
+{
+    public static function submit(?int $userId): RedirectResponse
+    {
+        try {
+            app(CleanupRequests::class)->submit($userId);
+
+            return redirect()->back()->with('success', __('dualstack.cleanup-queued'));
+        } catch (CleanupRejected $error) {
+            return redirect()->back()->withErrors(__($error->getMessage()));
+        } catch (Throwable $error) {
+            // SQL e dados de conexao nao devem vazar para a resposta ou para o log.
+            Log::error('Falha ao registrar limpeza dualstack.', ['exception' => $error::class]);
+
+            return redirect()->back()->withErrors(__('dualstack.cleanup-unavailable'));
+        }
+    }
+}
diff --git a/app/Services/Dualstack/Counter.php b/app/Services/Dualstack/Counter.php
new file mode 100644
index 0000000000000000000000000000000000000000..71de837bb5fd27932819bcd0152e19c7c21fbd8a
--- /dev/null
+++ b/app/Services/Dualstack/Counter.php
@@ -0,0 +1,94 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use InvalidArgumentException;
+use OverflowException;
+
+/** Contadores de protocolo sao uint64; JSON/Lua nao podem arredondar seus valores. */
+final class Counter
+{
+    public const MAX = '18446744073709551615';
+
+    public static function of(string|int $value): string
+    {
+        $value = (string) $value;
+
+        if ($value === '' || \strlen($value) > 20 || !ctype_digit($value)) {
+            throw new InvalidArgumentException('Contador cumulativo invalido.');
+        }
+        $value = ltrim($value, '0') ?: '0';
+
+        if (self::compare($value, self::MAX) > 0) {
+            throw new OverflowException('Contador fora do intervalo uint64.');
+        }
+
+        return $value;
+    }
+
+    public static function compare(string $a, string $b): int
+    {
+        return \strlen($a) <=> \strlen($b) ?: strcmp($a, $b);
+    }
+
+    public static function maximum(string $a, string $b): string
+    {
+        return self::compare($a, $b) >= 0 ? $a : $b;
+    }
+
+    public static function add(string $a, string $b): string
+    {
+        $length = max(\strlen($a), \strlen($b));
+        $a = str_pad($a, $length, '0', STR_PAD_LEFT);
+        $b = str_pad($b, $length, '0', STR_PAD_LEFT);
+        $carry = 0;
+        $result = '';
+
+        for ($i = $length - 1; $i >= 0; $i--) {
+            $digit = (int) $a[$i] + (int) $b[$i] + $carry;
+            $result = (string) ($digit % 10).$result;
+            $carry = intdiv($digit, 10);
+        }
+
+        return self::of(($carry ? (string) $carry : '').$result);
+    }
+
+    public static function delta(string $received, string $reference): string
+    {
+        if (self::compare($received, $reference) <= 0) {
+            return '0';
+        }
+        $reference = str_pad($reference, \strlen($received), '0', STR_PAD_LEFT);
+        $result = '';
+        $borrow = 0;
+
+        for ($i = \strlen($received) - 1; $i >= 0; $i--) {
+            $digit = (int) $received[$i] - (int) $reference[$i] - $borrow;
+            $borrow = $digit < 0 ? 1 : 0;
+            $result = (string) ($digit + 10 * $borrow).$result;
+        }
+
+        return ltrim($result, '0') ?: '0';
+    }
+
+    /** Aplica percentual inteiro e arredonda para baixo como a contabilidade legada. */
+    public static function percent(string $value, int $percent): string
+    {
+        if ($percent < 0 || $percent > 200) {
+            throw new InvalidArgumentException('Percentual de credito invalido.');
+        }
+        $carry = 0;
+        $product = '';
+
+        for ($i = \strlen($value) - 1; $i >= 0; $i--) {
+            $digit = (int) $value[$i] * $percent + $carry;
+            $product = (string) ($digit % 10).$product;
+            $carry = intdiv($digit, 10);
+        }
+        $product = ($carry > 0 ? (string) $carry : '').$product;
+
+        return self::of(\strlen($product) > 2 ? (ltrim(substr($product, 0, -2), '0') ?: '0') : '0');
+    }
+}
diff --git a/app/Services/Dualstack/DeletedEntities.php b/app/Services/Dualstack/DeletedEntities.php
new file mode 100644
index 0000000000000000000000000000000000000000..22c592d19c1c8d7ecfb63a30475ba86b0a0f7668
--- /dev/null
+++ b/app/Services/Dualstack/DeletedEntities.php
@@ -0,0 +1,171 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+use RuntimeException;
+use Throwable;
+
+/** deleted_at e a intencao duravel; so o proprietario sela e remove dados do swarm. */
+final class DeletedEntities
+{
+    public static function assertSupported(): void
+    {
+        if (!config('dualstack.enabled') || !config('announce.external_tracker.is_enabled')) {
+            return;
+        }
+
+        try {
+            $capabilities = \App\Services\Unit3dAnnounce::getCapabilities();
+        } catch (Throwable) {
+            $capabilities = false;
+        }
+        abort_unless(\is_array($capabilities) && ($capabilities['dualstack'] ?? false) === true
+            && ($capabilities['coordinated_deletion'] ?? false) === true, 503, __('dualstack.deletion-unavailable'));
+    }
+
+    public static function restoreFences(TrackerLease $lease): void
+    {
+        foreach (['users', 'torrents'] as $table) {
+            DB::table($table)->whereNotNull('deleted_at')->select('id')->orderBy('id')
+                ->chunkById(500, function ($rows) use ($lease, $table): void {
+                    $lease->renew();
+                    Redis::connection('announce')->sAdd($lease->prefix().':deleted-'.$table, ...$rows->pluck('id')->all());
+                });
+        }
+    }
+
+    public function processNext(TrackerLease $lease, TransitionWriter $writer): bool
+    {
+        foreach (['users' => 'user_id', 'torrents' => 'torrent_id'] as $table => $column) {
+            $entity = DB::table($table)->whereNotNull('deleted_at')->where('tracker_removal_state', '<', 2)->orderBy('id')->first(['id']);
+
+            if ($entity !== null) {
+                $this->removeBatch($lease, $writer, $table, $column, (int) $entity->id);
+
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function removeBatch(TrackerLease $lease, TransitionWriter $writer, string $table, string $column, int $id): void
+    {
+        $redis = Redis::connection('announce');
+        // O fence e a fronteira do journal sao atomicos com os announces em voo.
+        $barrier = $redis->eval(
+            <<<'LUA'
+if redis.call('HGET', KEYS[1], 'owner_id') ~= ARGV[1] or redis.call('GET', KEYS[2]) ~= ARGV[1] then return {'unavailable'} end
+redis.call('SADD', KEYS[3], ARGV[2])
+local last = redis.call('XREVRANGE', KEYS[4], '+', '-', 'COUNT', 1)
+return {'ok', #last > 0 and last[1][1] or ''}
+LUA,
+            4,
+            TrackerLease::base().':owner',
+            TrackerLease::base().':heartbeat',
+            $lease->prefix().':deleted-'.$table,
+            TrackerLease::base().':transitions',
+            $lease->ownerId,
+            $id
+        );
+
+        if ($barrier[0] !== 'ok') {
+            throw new RuntimeException('Propriedade perdida durante remocao.');
+        }
+        $deadline = hrtime(true) + 120e9;
+
+        while ($barrier[1] !== '' && $redis->xRange(TrackerLease::base().':transitions', '-', $barrier[1], 1) !== []) {
+            if (hrtime(true) >= $deadline) {
+                throw new RuntimeException('Remocao aguarda transicoes confirmadas; prazo excedido.');
+            }
+            $lease->renew();
+
+            if ($writer->flush('coordinator-'.$lease->ownerId, true) === 0) {
+                usleep(100000);
+            }
+        }
+        // Selado so apos commit E ack. Reentregas antigas nao podem recriar o historico.
+        DB::transaction(function () use ($lease, $table, $id): void {
+            $lease->assertPersistable();
+            $entity = DB::table($table)->where('id', $id)->lockForUpdate()->first(['deleted_at']);
+
+            if ($entity === null || $entity->deleted_at === null) {
+                throw new RuntimeException('Entidade restaurada durante remocao; recupere o tracker.');
+            }
+            DB::table($table)->where('id', $id)->where('tracker_removal_state', 0)->update(['tracker_removal_state' => 1]);
+        }, 3);
+        $removed = DB::transaction(function () use ($lease, $table, $column, $id): array {
+            $lease->assertPersistable();
+            $rows = DB::table('peers')->where($column, $id)->orderBy('user_id')->orderBy('torrent_id')->orderBy('peer_id')->limit(200)->get();
+
+            if ($rows->isNotEmpty()) {
+                DB::table('users')->whereIn('id', $rows->pluck('user_id')->unique())->orderBy('id')->lockForUpdate()->get(['id']);
+                DB::table('torrents')->whereIn('id', $rows->pluck('torrent_id')->unique())->orderBy('id')->lockForUpdate()->get(['id']);
+                $ids = $rows->map(fn ($row) => [$row->user_id, $row->torrent_id, $row->peer_id])->all();
+                $rows = TransitionWriter::tuples('peers', ['user_id', 'torrent_id', 'peer_id'], $ids)->orderBy('user_id')->orderBy('torrent_id')->orderBy('peer_id')->lockForUpdate()->get();
+                $endpoints = TransitionWriter::tuples('peer_ips', ['user_id', 'torrent_id', 'peer_id'], $ids)->get()
+                    ->groupBy(fn ($e) => $e->user_id.':'.$e->torrent_id.':'.bin2hex($e->peer_id));
+                $deltas = [];
+
+                foreach ($rows as $peer) {
+                    $key = $peer->user_id.':'.$peer->torrent_id.':'.bin2hex($peer->peer_id);
+                    $eligible = ($endpoints[$key] ?? collect())->filter(fn ($e) => !config('dualstack.require_connectivity') || $e->connectable === 1);
+
+                    if (!$peer->active || !$peer->visible || $eligible->isEmpty()) {
+                        continue;
+                    }
+                    $count = $peer->seeder ? 'seeders' : 'leechers';
+
+                    foreach ([$count, ...$eligible->map(fn ($e) => $count.'_ipv'.$e->family)->all()] as $field) {
+                        $deltas[$peer->torrent_id][$field] = ($deltas[$peer->torrent_id][$field] ?? 0) + 1;
+                    }
+                }
+
+                if ($deltas !== []) {
+                    $sets = $bindings = [];
+
+                    foreach (['seeders', 'leechers', 'seeders_ipv4', 'seeders_ipv6', 'leechers_ipv4', 'leechers_ipv6'] as $field) {
+                        $case = $field.'='.$field.'-CASE id';
+
+                        foreach ($deltas as $torrentId => $counts) {
+                            $case .= ' WHEN ? THEN ?';
+                            array_push($bindings, $torrentId, $counts[$field] ?? 0);
+                        }
+                        $sets[] = $case.' ELSE 0 END';
+                    }
+                    array_push($bindings, ...array_keys($deltas));
+                    DB::update('UPDATE torrents SET '.implode(',', $sets).' WHERE id IN ('.implode(',', array_fill(0, \count($deltas), '?')).')', $bindings);
+                }
+                TransitionWriter::tuples('peers', ['user_id', 'torrent_id', 'peer_id'], $ids)->delete();
+
+                return ['peers' => $ids, 'history' => []];
+            }
+            $rows = DB::table('history')->where($column, $id)->orderBy('user_id')->orderBy('torrent_id')->limit(200)->get(['user_id', 'torrent_id']);
+            $ids = $rows->map(fn ($row) => [$row->user_id, $row->torrent_id])->all();
+
+            if ($ids !== []) {
+                TransitionWriter::tuples('history', ['user_id', 'torrent_id'], $ids)->delete();
+            } else {
+                DB::table($table)->where('id', $id)->update(['tracker_removal_state' => 2]);
+            }
+
+            return ['peers' => [], 'history' => $ids];
+        }, 3);
+        $redis->pipeline(function ($pipe) use ($lease, $removed): void {
+            foreach ($removed['peers'] as [$user, $torrent, $peer]) {
+                $key = $user.':'.$torrent.':'.bin2hex($peer);
+                $pipe->del($lease->prefix().':peer:'.$key);
+                $pipe->zRem($lease->prefix().':expiry', $key);
+                $pipe->zRem($lease->prefix().':user-leechers:'.$user, $key);
+            }
+
+            foreach ($removed['history'] as [$user, $torrent]) {
+                $pipe->del($lease->prefix().':history:'.$user.':'.$torrent);
+            }
+        });
+    }
+}
diff --git a/app/Services/Dualstack/EndpointAddress.php b/app/Services/Dualstack/EndpointAddress.php
new file mode 100644
index 0000000000000000000000000000000000000000..c2470d461f94c6e072f5a5d28fa6a41059de6013
--- /dev/null
+++ b/app/Services/Dualstack/EndpointAddress.php
@@ -0,0 +1,51 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use InvalidArgumentException;
+
+final readonly class EndpointAddress
+{
+    private function __construct(public int $family, public string $binary)
+    {
+    }
+
+    public static function observed(string $address, bool $allowPrivate = false): self
+    {
+        $binary = @inet_pton($address);
+
+        if ($binary === false) {
+            throw new InvalidArgumentException('Endereco de origem invalido.');
+        }
+
+        if (\strlen($binary) === 16 && substr($binary, 0, 12) === str_repeat("\0", 10)."\xff\xff") {
+            $binary = substr($binary, 12);
+        }
+        $family = \strlen($binary) === 4 ? 4 : 6;
+        $first = \ord($binary[0]);
+        $second = \ord($binary[1]);
+
+        if ($family === 4) {
+            $invalid = $first === 0 || $first === 127 || $first >= 224 || ($first === 169 && $second === 254);
+            $private = $first === 10 || ($first === 172 && $second >= 16 && $second <= 31)
+                || ($first === 192 && $second === 168) || ($first === 100 && $second >= 64 && $second <= 127);
+        } else {
+            $invalid = $binary === str_repeat("\0", 16) || $binary === str_repeat("\0", 15)."\x01"
+                || $first === 255 || ($first === 254 && ($second & 192) === 128);
+            $private = ($first & 254) === 252;
+        }
+
+        if ($invalid || ($private && !$allowPrivate)) {
+            throw new InvalidArgumentException('Endereco de origem nao publicavel.');
+        }
+
+        return new self($family, $binary);
+    }
+
+    public function text(): string
+    {
+        return inet_ntop($this->binary);
+    }
+}
diff --git a/app/Services/Dualstack/EndpointProbe.php b/app/Services/Dualstack/EndpointProbe.php
new file mode 100644
index 0000000000000000000000000000000000000000..6d45a88030c70349712e86a469b1706b9a79aecc
--- /dev/null
+++ b/app/Services/Dualstack/EndpointProbe.php
@@ -0,0 +1,102 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+use RuntimeException;
+
+/** TCP confirma alcance da porta; nao comprova transferencia BitTorrent. */
+final class EndpointProbe
+{
+    public function runBatch(int $limit = 25): int
+    {
+        if (!config('announce.connectable_check')) {
+            return 0;
+        }
+        $lease = TrackerLease::current();
+        $policy = Policy::configured();
+        $now = (int) Redis::connection('announce')->time()[0];
+        $rows = DB::table('peer_ips as e')->join('peers as p', function ($join): void {
+            $join->on('e.user_id', '=', 'p.user_id')->on('e.torrent_id', '=', 'p.torrent_id')->on('e.peer_id', '=', 'p.peer_id');
+        })->where('p.active', true)->where('e.last_announced_at', '>', gmdate('Y-m-d H:i:s', $now - $policy['endpoint_ttl']))
+            ->where(fn ($query) => $query->whereNull('e.connectivity_checked_at')->orWhere('e.connectivity_checked_at', '<', gmdate('Y-m-d H:i:s', $now - (int) config('announce.connectable_check_interval'))))
+            ->orderBy('e.connectivity_checked_at')->orderBy('e.updated_at')->limit($limit)->get(['e.*']);
+        $published = 0;
+
+        foreach ($rows as $row) {
+            $ip = EndpointAddress::observed(inet_ntop($row->ip), $policy['allow_private_addresses']);
+            $connectable = $this->check($lease, $ip, (int) $row->port);
+
+            if ($connectable === null) {
+                continue;
+            }
+            $result = (new TransitionJournal($lease))->publish(
+                [
+                    'user_id' => (int) $row->user_id, 'torrent_id' => (int) $row->torrent_id, 'peer_id' => bin2hex($row->peer_id),
+                ],
+                ['kind' => 'probe', 'ip' => $ip->text(), 'port' => (int) $row->port, 'revision' => (int) $row->revision, 'connectable' => $connectable],
+                $policy,
+                ['upload_percent' => 100, 'download_percent' => 100, 'immune' => false]
+            );
+            $published += $result['outcome'] === 'accepted' ? 1 : 0;
+        }
+
+        return $published;
+    }
+
+    private function check(TrackerLease $lease, EndpointAddress $ip, int $port): ?bool
+    {
+        $redis = Redis::connection('announce');
+        $keys = [$lease->prefix().':probe-values', $lease->prefix().':probe-expiry'];
+        $key = hash('sha256', $ip->binary.pack('n', $port));
+        $token = bin2hex(random_bytes(16));
+        $capacity = (int) config('dualstack.connectivity_cache_entries');
+        $ttl = (int) config('dualstack.connectivity_cache_ttl');
+
+        if ($capacity < 1 || $ttl < 1) {
+            throw new RuntimeException('Limites do cache de conectividade invalidos.');
+        }
+        $result = $redis->eval(<<<'LUA'
+local now = tonumber(redis.call('TIME')[1])
+local expired = redis.call('ZRANGEBYSCORE', KEYS[2], '-inf', now, 'LIMIT', 0, 1000)
+for _, member in ipairs(expired) do redis.call('HDEL', KEYS[1], member); redis.call('ZREM', KEYS[2], member) end
+local old = redis.call('HGET', KEYS[1], ARGV[1])
+local deadline = redis.call('ZSCORE', KEYS[2], ARGV[1])
+if old and (not deadline or tonumber(deadline) <= now) then
+    redis.call('HDEL', KEYS[1], ARGV[1]); redis.call('ZREM', KEYS[2], ARGV[1]); old = false
+end
+if old == '1' or old == '0' then return {'cached', old} end
+if old or redis.call('ZCARD', KEYS[2]) >= tonumber(ARGV[3]) or redis.call('HLEN', KEYS[1]) >= tonumber(ARGV[3]) then return {'busy'} end
+redis.call('HSET', KEYS[1], ARGV[1], ARGV[2])
+redis.call('ZADD', KEYS[2], now + 10, ARGV[1])
+return {'probe'}
+LUA, 2, ...[...$keys, $key, $token, $capacity]);
+
+        if ($result[0] === 'busy') {
+            return null;
+        }
+
+        if ($result[0] === 'cached') {
+            return $result[1] === '1';
+        }
+        // Fora do CAS, do lock SQL e do coordenador de persistencia.
+        $host = $ip->family === 6 ? '['.$ip->text().']' : $ip->text();
+        $connection = @fsockopen($host, $port, $errno, $error, 1.0);
+        $connectable = \is_resource($connection);
+
+        if ($connectable) {
+            fclose($connection);
+        }
+        $stored = $redis->eval(<<<'LUA'
+if redis.call('HGET', KEYS[1], ARGV[1]) ~= ARGV[2] then return 0 end
+redis.call('HSET', KEYS[1], ARGV[1], ARGV[3])
+redis.call('ZADD', KEYS[2], tonumber(redis.call('TIME')[1]) + tonumber(ARGV[4]), ARGV[1])
+return 1
+LUA, 2, ...[...$keys, $key, $token, $connectable ? '1' : '0', $ttl]);
+
+        return $stored === 1 ? $connectable : null;
+    }
+}
diff --git a/app/Services/Dualstack/EndpointView.php b/app/Services/Dualstack/EndpointView.php
new file mode 100644
index 0000000000000000000000000000000000000000..deedbab1d251dfa095f06f485ba67a74fb19d25e
--- /dev/null
+++ b/app/Services/Dualstack/EndpointView.php
@@ -0,0 +1,77 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Query\Builder as Query;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+/** Leitura paginada com identidade composta e uma consulta de endpoints. */
+final class EndpointView
+{
+    private static function related(): Query
+    {
+        return DB::table('peer_ips as endpoint')->whereColumn('endpoint.user_id', 'peers.user_id')
+            ->whereColumn('endpoint.torrent_id', 'peers.torrent_id')->whereColumn('endpoint.peer_id', 'peers.peer_id');
+    }
+
+    public static function selectNetwork(Builder $query): void
+    {
+        if (config('dualstack.enabled')) {
+            // Valores de ordenacao; a view exibe a colecao completa da pagina.
+            $query->addSelect(['ip' => self::related()->selectRaw('MIN(INET6_NTOA(endpoint.ip))'),
+                'port'              => self::related()->selectRaw('MIN(endpoint.port)')]);
+        } else {
+            $query->addSelect('peers.port')->selectRaw('INET6_NTOA(peers.ip) AS ip');
+        }
+    }
+
+    public static function filterNetwork(Builder $query, string $ip, string $port): void
+    {
+        if (config('dualstack.enabled')) {
+            if ($ip !== '' || $port !== '') {
+                $query->whereExists(self::related()->selectRaw('1')
+                    ->when($ip !== '', fn ($q) => $q->whereRaw('endpoint.ip = INET6_ATON(?)', [$ip]))
+                    ->when($port !== '', fn ($q) => $q->where('endpoint.port', $port)));
+            }
+        } else {
+            $query->when($ip !== '', fn ($q) => $q->whereRaw('peers.ip = INET6_ATON(?)', [$ip]))
+                ->when($port !== '', fn ($q) => $q->where('peers.port', $port));
+        }
+    }
+
+    /** @param Collection<int, \App\Models\Peer> $peers */
+    public static function load(Collection $peers): void
+    {
+        if (!config('dualstack.enabled') || $peers->isEmpty()) {
+            return;
+        }
+        $key = fn ($row) => $row->user_id.':'.$row->torrent_id.':'.bin2hex($row->peer_id);
+        $endpoints = TransitionWriter::tuples(
+            'peer_ips',
+            ['user_id', 'torrent_id', 'peer_id'],
+            $peers->map(fn ($peer) => [$peer->user_id, $peer->torrent_id, $peer->peer_id])->all()
+        )
+            ->select(['user_id', 'torrent_id', 'peer_id', 'family', 'port', 'connectable', 'last_announced_at'])
+            ->selectRaw('INET6_NTOA(ip) AS ip_address')->orderBy('family')->get();
+        $cutoff = now()->subSeconds((int) config('dualstack.endpoint_ttl'))->format('Y-m-d H:i:s');
+
+        foreach ($endpoints as $endpoint) {
+            $endpoint->current = $endpoint->last_announced_at > $cutoff;
+            $endpoint->connectable = $endpoint->connectable === null ? null : (bool) $endpoint->connectable;
+        }
+        $grouped = $endpoints->groupBy($key);
+
+        foreach ($endpoints as $endpoint) {
+            unset($endpoint->user_id, $endpoint->torrent_id, $endpoint->peer_id);
+        }
+
+        foreach ($peers as $peer) {
+            $peer->setRelation('endpoints', $grouped->get($key($peer), collect()));
+            $peer->makeHidden('peer_id');
+        }
+    }
+}
diff --git a/app/Services/Dualstack/ExternalTorrent.php b/app/Services/Dualstack/ExternalTorrent.php
new file mode 100644
index 0000000000000000000000000000000000000000..5ad6e1a3330e4db36fcca7419ac8c4457c584ea9
--- /dev/null
+++ b/app/Services/Dualstack/ExternalTorrent.php
@@ -0,0 +1,106 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use InvalidArgumentException;
+use OverflowException;
+
+/** Leitor do contrato administrativo schema 1. Nao usa a projecao legada de IP. */
+final class ExternalTorrent
+{
+    public static function normalize(array $torrent): array
+    {
+        $capabilities = $torrent['capabilities'] ?? null;
+
+        if (!\is_array($capabilities) || ($capabilities['dualstack'] ?? null) !== true
+            || ($capabilities['peer_schema'] ?? null) !== 1 || ($capabilities['peer_count'] ?? null) !== 'unique'
+            || !\in_array($capabilities['max_endpoints'] ?? null, [1, 2], true)) {
+            return [];
+        }
+
+        foreach (['seeders', 'leechers'] as $kind) {
+            foreach ([$kind, $kind.'_ipv4', $kind.'_ipv6'] as $field) {
+                if (!\is_int($torrent[$field] ?? null) || $torrent[$field] < 0) {
+                    return [];
+                }
+            }
+
+            if ($torrent[$kind] < max($torrent[$kind.'_ipv4'], $torrent[$kind.'_ipv6'])
+                || $torrent[$kind] > $torrent[$kind.'_ipv4'] + $torrent[$kind.'_ipv6']) {
+                return [];
+            }
+        }
+
+        foreach ($torrent['peers'] as $key => &$peer) {
+            if (!\is_array($peer) || !preg_match('/^([1-9][0-9]*)-([0-9a-fA-F]{40})$/D', (string) $key, $identity)
+                || !\is_array($peer['endpoints'] ?? null) || !array_is_list($peer['endpoints']) || \count($peer['endpoints']) > 2) {
+                return [];
+            }
+
+            foreach (['is_seeder', 'is_active', 'is_visible', 'connectable'] as $field) {
+                if (!\is_bool($peer[$field] ?? null)) {
+                    return [];
+                }
+            }
+
+            foreach (['updated_at', 'created_at', 'state_version', 'session_generation'] as $field) {
+                if (!\is_int($peer[$field] ?? null) || $peer[$field] < 0) {
+                    return [];
+                }
+            }
+
+            try {
+                foreach (['uploaded', 'downloaded', 'left'] as $field) {
+                    if (!\is_string($peer[$field] ?? null)) {
+                        return [];
+                    }
+                    $peer[$field] = Counter::of($peer[$field]);
+                }
+
+                $families = [];
+
+                foreach ($peer['endpoints'] as &$endpoint) {
+                    if (!\is_array($endpoint) || !\in_array($endpoint['family'] ?? null, [4, 6], true)
+                        || isset($families[$endpoint['family']]) || !\is_string($endpoint['ip_address'] ?? null)
+                        || !\is_int($endpoint['port'] ?? null) || $endpoint['port'] < 1024 || $endpoint['port'] > 65535
+                        || !\array_key_exists('connectable', $endpoint) || ($endpoint['connectable'] !== null && !\is_bool($endpoint['connectable']))) {
+                        return [];
+                    }
+
+                    $address = EndpointAddress::observed($endpoint['ip_address'], true);
+
+                    if ($address->family !== $endpoint['family']) {
+                        return [];
+                    }
+
+                    foreach (['last_announced_at', 'revision'] as $field) {
+                        if (!\is_int($endpoint[$field] ?? null) || $endpoint[$field] < 0) {
+                            return [];
+                        }
+                    }
+
+                    if (!\array_key_exists('connectivity_checked_at', $endpoint)
+                        || ($endpoint['connectivity_checked_at'] !== null && (!\is_int($endpoint['connectivity_checked_at']) || $endpoint['connectivity_checked_at'] < 0))) {
+                        return [];
+                    }
+                    $families[$endpoint['family']] = true;
+                    $endpoint['ip_address'] = $address->text();
+                }
+                unset($endpoint);
+            } catch (InvalidArgumentException|OverflowException) {
+                return [];
+            }
+
+            if ($peer['is_active'] !== ($peer['endpoints'] !== [])) {
+                return [];
+            }
+            $peer['user_id'] = (int) $identity[1];
+            $peer['peer_id'] = hex2bin($identity[2]);
+        }
+        unset($peer);
+
+        return $torrent;
+    }
+}
diff --git a/app/Services/Dualstack/LegacyReconciliation.php b/app/Services/Dualstack/LegacyReconciliation.php
new file mode 100644
index 0000000000000000000000000000000000000000..e91af0462a6f83c852d6d66e484ae45500330b70
--- /dev/null
+++ b/app/Services/Dualstack/LegacyReconciliation.php
@@ -0,0 +1,221 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Facades\Redis;
+use InvalidArgumentException;
+use RuntimeException;
+
+/** Manutencao offline: binarios originais nao participam da exclusao por geracao. */
+final class LegacyReconciliation
+{
+    public function run(string $action, int $batch): int
+    {
+        if (config('dualstack.enabled') || !\in_array($action, ['prepare', 'reconcile'], true) || $batch < 1 || $batch > 2000) {
+            throw new RuntimeException('Manutencao exige dualstack desativado e parametros validos.');
+        }
+        $lock = $this->lockName();
+
+        if ((int) DB::selectOne('SELECT GET_LOCK(?, 0) AS acquired', [$lock])->acquired !== 1) {
+            throw new RuntimeException('Outra reconciliacao esta em andamento.');
+        }
+
+        try {
+            $this->transaction(function () use ($action): void {
+                $owner = DB::table('tracker_ownership')->where('id', 1)
+                    ->selectRaw('*, lease_expires_at > UTC_TIMESTAMP(3) AS live')->lockForUpdate()->first();
+
+                if ($owner === null || $owner->live) {
+                    throw new RuntimeException('Interrompa o proprietario ativo antes da manutencao.');
+                }
+                $this->assertDrained();
+
+                if ($owner->backend === 'php' && !$owner->php_journal_drained) {
+                    throw new RuntimeException('Recupere e drene o journal PHP antes da manutencao.');
+                }
+
+                if ($action === 'reconcile' && !$owner->legacy_reconciliation_required) {
+                    throw new RuntimeException('Execute prepare antes da reconciliacao.');
+                }
+                DB::table('tracker_ownership')->where('id', 1)->update(['legacy_reconciliation_required' => true]);
+            });
+            // A marca SQL ja impede nova aquisicao. A lease anterior expirou e nao pode renovar.
+            Redis::connection('announce')->hSet(TrackerLease::base().':owner', 'ready', '0');
+            Redis::connection('announce')->del(TrackerLease::base().':heartbeat');
+
+            if ($action === 'prepare') {
+                return 0;
+            }
+            $count = $this->reconcilePeers($batch);
+            $this->reconcileHistory($batch);
+            $this->reconcileCounts($batch);
+            $this->assertDrained();
+            $this->transaction(fn () => DB::table('tracker_ownership')->where('id', 1)->update(['legacy_reconciliation_required' => false]));
+
+            return $count;
+        } finally {
+            DB::selectOne('SELECT RELEASE_LOCK(?) AS released', [$lock]);
+        }
+    }
+
+    private function lockName(): string
+    {
+        return 'dualstack:legacy:'.substr(hash('sha256', DB::getDatabaseName()), 0, 40);
+    }
+
+    private function transaction(callable $callback): void
+    {
+        DB::transaction(function () use ($callback): void {
+            // Uma reconexao do PDO perde GET_LOCK. Nunca continuar usando so a marca
+            // de manutencao, pois outra instancia pode ter adquirido a exclusao.
+            if ((int) DB::selectOne('SELECT IS_USED_LOCK(?) = CONNECTION_ID() AS held', [$this->lockName()])->held !== 1) {
+                throw new RuntimeException('Conexao perdeu a exclusao da reconciliacao; mantenha offline e retome o comando.');
+            }
+            $callback();
+        }, 3);
+    }
+
+    private function assertDrained(): void
+    {
+        $redis = Redis::connection('announce');
+
+        if ($redis->xLen(TrackerLease::base().':transitions') !== 0 || Queue::connection()->size() !== 0) {
+            throw new RuntimeException('Drene o journal e a fila de jobs antes da manutencao.');
+        }
+
+        foreach (['peers', 'histories', 'announces'] as $name) {
+            if ($redis->lLen(config('cache.prefix').':'.$name.':batch') !== 0) {
+                throw new RuntimeException('Drene os lotes legados antes da manutencao.');
+            }
+        }
+
+        if (DB::table('tracker_cleanup_requests')->exists()
+            || DB::table('users')->where('tracker_removal_state', 1)->exists()
+            || DB::table('torrents')->where('tracker_removal_state', 1)->exists()) {
+            throw new RuntimeException('Conclua limpezas e remocoes pendentes antes da manutencao.');
+        }
+    }
+
+    private function reconcilePeers(int $batch): int
+    {
+        $cursor = null;
+        $count = 0;
+        $cutoff = now()->subSeconds((int) config('dualstack.endpoint_ttl'))->toDateTimeString();
+
+        do {
+            $query = DB::table('peers')->orderBy('user_id')->orderBy('torrent_id')->orderBy('peer_id')->limit($batch);
+
+            if ($cursor !== null) {
+                $query->whereRaw('(user_id, torrent_id, peer_id) > (?, ?, ?)', $cursor);
+            }
+            $peers = $query->get();
+
+            if ($peers->isEmpty()) {
+                break;
+            }
+            $last = $peers->last();
+            $next = [$last->user_id, $last->torrent_id, $last->peer_id];
+            $rows = [];
+
+            foreach ($peers as $peer) {
+                if (!$peer->active || ($peer->updated_at ?? '') <= $cutoff) {
+                    continue;
+                }
+
+                try {
+                    $address = EndpointAddress::observed(@inet_ntop($peer->ip) ?: '', (bool) config('dualstack.allow_private_addresses'));
+                } catch (InvalidArgumentException) {
+                    throw new RuntimeException('Peer ativo possui IP legado invalido/nao permitido; corrija a origem antes de retomar.');
+                }
+
+                if ($peer->port < 1 || $peer->port > 65535 || $peer->state_version >= PHP_INT_MAX) {
+                    throw new RuntimeException('Peer ativo possui porta ou versao legada invalida.');
+                }
+                $rows[] = [
+                    'user_id'           => $peer->user_id, 'torrent_id' => $peer->torrent_id, 'peer_id' => $peer->peer_id,
+                    'family'            => $address->family, 'ip' => $address->binary, 'port' => $peer->port,
+                    'connectable'       => $peer->connectable ? true : null, 'connectivity_checked_at' => null,
+                    'last_announced_at' => $peer->updated_at, 'revision' => (int) $peer->state_version + 1,
+                    'created_at'        => $peer->created_at, 'updated_at' => $peer->updated_at,
+                ];
+            }
+            // Faixa da PK, nao uma consulta por peer. Um lote e seu snapshot sao atomicos.
+            $this->transaction(function () use ($cursor, $next, $rows, $cutoff): void {
+                $range = '(user_id, torrent_id, peer_id) <= (?, ?, ?)';
+                $bindings = $next;
+
+                if ($cursor !== null) {
+                    $range .= ' AND (user_id, torrent_id, peer_id) > (?, ?, ?)';
+                    $bindings = [...$bindings, ...$cursor];
+                }
+                DB::table('peer_ips')->whereRaw($range, $bindings)->delete();
+
+                if ($rows !== []) {
+                    DB::table('peer_ips')->insert($rows);
+                }
+                DB::table('peers')->whereRaw($range, $bindings)->update([
+                    'protocol_state'      => null,
+                    'completion_reported' => DB::raw('seeder OR EXISTS (SELECT 1 FROM history h WHERE h.user_id=peers.user_id AND h.torrent_id=peers.torrent_id AND h.completed_at IS NOT NULL)'),
+                ]);
+                DB::table('peers')->whereRaw($range, $bindings)->where(function ($query) use ($cutoff): void {
+                    $query->where('active', false)->orWhere('updated_at', '<=', $cutoff)->orWhereNull('updated_at');
+                })->update(['active' => false, 'connectable' => false]);
+            });
+            $count += $peers->count();
+            $cursor = $next;
+        } while ($peers->count() === $batch);
+
+        return $count;
+    }
+
+    private function reconcileHistory(int $batch): void
+    {
+        $cursor = null;
+
+        do {
+            $query = DB::table('history')->select(['user_id', 'torrent_id'])->orderBy('user_id')->orderBy('torrent_id')->limit($batch);
+
+            if ($cursor !== null) {
+                $query->whereRaw('(user_id, torrent_id) > (?, ?)', $cursor);
+            }
+            $rows = $query->get();
+
+            if ($rows->isEmpty()) {
+                break;
+            }
+            $last = $rows->last();
+            $next = [$last->user_id, $last->torrent_id];
+            $update = DB::table('history')->whereRaw('(user_id, torrent_id) <= (?, ?)', $next);
+
+            if ($cursor !== null) {
+                $update->whereRaw('(user_id, torrent_id) > (?, ?)', $cursor);
+            }
+            // Nao creditar novamente o tempo ja contabilizado pelo escritor legado.
+            $this->transaction(fn () => $update->update([
+                'swarm_updated_at' => DB::raw('updated_at'),
+                'active'           => DB::raw('EXISTS (SELECT 1 FROM peers p WHERE p.user_id=history.user_id AND p.torrent_id=history.torrent_id AND p.active=1)'),
+                'seeder'           => DB::raw('EXISTS (SELECT 1 FROM peers p WHERE p.user_id=history.user_id AND p.torrent_id=history.torrent_id AND p.active=1 AND p.seeder=1)'),
+            ]));
+            $cursor = $next;
+        } while ($rows->count() === $batch);
+    }
+
+    private function reconcileCounts(int $batch): void
+    {
+        $connectivity = config('dualstack.require_connectivity') ? ' AND e.connectable=1' : '';
+        DB::table('torrents')->select('id')->orderBy('id')->chunkById($batch, function ($rows) use ($connectivity): void {
+            $updates = [];
+
+            foreach (['seeders' => 1, 'leechers' => 0] as $name => $seeder) {
+                foreach (['' => '', '_ipv4' => ' AND e.family=4', '_ipv6' => ' AND e.family=6'] as $suffix => $family) {
+                    $updates[$name.$suffix] = DB::raw("(SELECT COUNT(*) FROM peers p WHERE p.torrent_id=torrents.id AND p.active=1 AND p.visible=1 AND p.seeder={$seeder} AND EXISTS (SELECT 1 FROM peer_ips e WHERE e.user_id=p.user_id AND e.torrent_id=p.torrent_id AND e.peer_id=p.peer_id {$family} {$connectivity}))");
+                }
+            }
+            $this->transaction(fn () => DB::table('torrents')->whereIn('id', $rows->pluck('id'))->update($updates));
+        });
+    }
+}
diff --git a/app/Services/Dualstack/PeerCountDisplay.php b/app/Services/Dualstack/PeerCountDisplay.php
