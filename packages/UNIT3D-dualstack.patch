+    $this->request = ['event' => 'started', 'ip' => '172.29.92.30', 'port' => 6881, 'uploaded' => '1000', 'downloaded' => '0', 'left' => '100', 'visible' => true, 'agent' => 'dualstack-journal-test'];
+    $this->lease = TrackerLease::acquire();
