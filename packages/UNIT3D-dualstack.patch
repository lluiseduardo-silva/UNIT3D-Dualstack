+                    'last_announced_at' => 1700000000, 'connectivity_checked_at' => 1700000000, 'revision' => 1],
+                ['family'               => 6, 'ip_address' => '2001:db8::30', 'port' => 6882, 'connectable' => null,
+                    'last_announced_at' => 1700000000, 'connectivity_checked_at' => null, 'revision' => 1],
+            ],
+        ]],
+    ];
+}
+
+it('le um peer com dois endpoints e preserva uint64 sem projecao legada', function (): void {
+    Http::fake(['*' => Http::response(administrativeTorrent())]);
+    $torrent = Unit3dAnnounce::getTorrent(12001);
+    $peer = array_values($torrent['peers'])[0];
+    expect($torrent['seeders'])->toBe(1)->and($torrent['capabilities']['dualstack'])->toBeTrue()
+        ->and($torrent['peers'])->toHaveCount(1)->and($peer['endpoints'])->toHaveCount(2)
+        ->and($peer['uploaded'])->toBe(Counter::MAX)->and($peer['user_id'])->toBe(12001)
+        ->and($peer['peer_id'])->toBe('-DS9200-000000000001');
+});
+
+it('recusa contratos novos invalidos', function (string $case): void {
+    $torrent = administrativeTorrent();
+    $peer = &$torrent['peers'][array_key_first($torrent['peers'])];
+
+    switch ($case) {
+        case 'familia repetida': $peer['endpoints'][1] = $peer['endpoints'][0];
+
+            break;
+        case 'ip nao corresponde': $peer['endpoints'][1]['ip_address'] = '192.0.2.99';
+
+            break;
+        case 'terceiro endpoint': $peer['endpoints'][] = $peer['endpoints'][0];
+
+            break;
+        case 'contador arredondado': $peer['uploaded'] = (float) Counter::MAX;
+
+            break;
+        case 'overflow': $peer['uploaded'] = '18446744073709551616';
+
+            break;
+        case 'schema desconhecido': $torrent['capabilities']['peer_schema'] = 2;
+
+            break;
+        case 'total duplicado': $torrent['seeders'] = 3;
+
+            break;
+        case 'ativo sem endpoint': $peer['endpoints'] = [];
+
+            break;
+    }
+    Http::fake(['*' => Http::response($torrent)]);
+    expect(Unit3dAnnounce::getTorrent(12001))->toBe([]);
+})->with(['familia repetida', 'ip nao corresponde', 'terceiro endpoint', 'contador arredondado', 'overflow', 'schema desconhecido', 'total duplicado', 'ativo sem endpoint']);
+
+it('aceita tracker legado sem apresenta-lo como dualstack', function (): void {
+    $torrent = administrativeTorrent();
+    unset($torrent['capabilities']);
+    $peer = &$torrent['peers'][array_key_first($torrent['peers'])];
+    unset($peer['endpoints']);
+    $peer['uploaded'] = 1000;
+    $peer['downloaded'] = 100;
+    $peer['ip_address'] = '192.0.2.30';
+    $peer['port'] = 6881;
+    Http::fake(['*' => Http::response($torrent)]);
+    expect(Unit3dAnnounce::getTorrent(12001)['capabilities']['dualstack'])->toBeFalse();
+});
+
+it('funciona sem backend externo configurado e sem fazer requests', function (): void {
+    config(['announce.external_tracker.is_enabled' => false]);
+    expect(Unit3dAnnounce::getCapabilities())->toBeTrue()->and(Unit3dAnnounce::getTorrent(12001))->toBeTrue();
+    Http::assertNothingSent();
+});
+
+it('reconhece capacidade explicita e endpoint ausente de backend antigo', function (): void {
+    Http::fake(['*' => Http::response(administrativeTorrent()['capabilities'])]);
+    expect(Unit3dAnnounce::getCapabilities()['peer_schema'])->toBe(1);
+    Http::swap(new Factory());
+    Http::fake(['*' => Http::response('', 404)]);
+    expect(Unit3dAnnounce::getCapabilities())->toBeFalse();
+});
+
+it('renderiza endpoints apenas quando a permissao de ip permite', function (): void {
+    $peer = array_values(administrativeTorrent()['peers'])[0];
+    $view = 'torrent.partials.external-peer-endpoints';
+    $hidden = view($view, ['peer' => $peer, 'dualstack' => true, 'canView' => false])->render();
+    expect($hidden)->not->toContain('192.0.2.30', '2001:db8::30', '6881', '6882');
+    $visible = view($view, ['peer' => $peer, 'dualstack' => true, 'canView' => true])->render();
+    expect($visible)->toContain('IPv4: 192.0.2.30', 'IPv6: 2001:db8::30', 'IPv4: 6881', 'IPv6: 6882')
+        ->and(substr_count($visible, '<td>'))->toBe(2);
+});
diff --git a/tests/Integration/DualstackHighspeedTest.php b/tests/Integration/DualstackHighspeedTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..af17a77b2178b4c0546cac77503a5ded0b80a088
--- /dev/null
+++ b/tests/Integration/DualstackHighspeedTest.php
@@ -0,0 +1,145 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\Seedbox;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\DB;
+
+beforeAll(function (): void {
+    $app = require __DIR__.'/../../bootstrap/app.php';
+    $app->make(Kernel::class)->bootstrap();
+});
+
+beforeEach(function (): void {
+    if (getenv('DUALSTACK_HIGHSPEED_TESTS') !== '1') {
+        $this->markTestSkipped('Exige MySQL real e banco isolado unit3d_dualstack_journal_test.');
+    }
+    expect(DB::getDriverName())->toBe('mysql')->and(DB::getDatabaseName())->toBe('unit3d_dualstack_journal_test');
+    expect(DB::table('tracker_ownership')->whereRaw('lease_expires_at > UTC_TIMESTAMP(3)')->exists())->toBeFalse();
+    DB::beginTransaction();
+    Carbon::setTestNow('2026-10-08 12:00:00');
+    config(['dualstack.enabled' => true, 'dualstack.endpoint_ttl' => 7200]);
+    DB::table('peers')->delete();
+    DB::table('seedboxes')->delete();
+    DB::table('torrents')->update(['highspeed' => true]);
+});
+
+afterEach(function (): void {
+    DB::disableQueryLog();
+    Carbon::setTestNow();
+
+    if (getenv('DUALSTACK_HIGHSPEED_TESTS') === '1' && DB::transactionLevel() > 0) {
+        DB::rollBack();
+    }
+});
+
+function highspeedSeedbox(string $ip): void
+{
+    Seedbox::withoutEvents(fn () => Seedbox::create(['user_id' => 12001, 'name' => 'Fixture isolada', 'ip' => $ip]));
+}
+
+function highspeedPeer(array $overrides = [], int $ipv6Age = 0): void
+{
+    $peer = array_replace([
+        'user_id'    => 12001, 'torrent_id' => 12001, 'peer_id' => str_repeat('S', 20),
+        'ip'         => inet_pton('192.0.2.199'), 'port' => 6999, 'agent' => 'highspeed-test',
+        'uploaded'   => 1000, 'downloaded' => 0, 'left' => 0, 'seeder' => true,
+        'active'     => true, 'visible' => true, 'connectable' => false,
+        'created_at' => now()->subHour(), 'updated_at' => now(),
+    ], $overrides);
+    DB::table('peers')->insert($peer);
+
+    foreach ([4 => '192.0.2.30', 6 => '2001:db8::30'] as $family => $ip) {
+        DB::table('peer_ips')->insert(array_intersect_key($peer, array_flip(['user_id', 'torrent_id', 'peer_id'])) + [
+            'family'     => $family, 'ip' => inet_pton($ip), 'port' => 6881, 'connectable' => null,
+            'revision'   => 1, 'last_announced_at' => now()->subSeconds($family === 6 ? $ipv6Age : 0),
+            'created_at' => now(), 'updated_at' => now(),
+        ]);
+    }
+}
+
+it('identifica seedbox em qualquer familia vigente sem depender da projecao', function (string $ip, int $age, bool $expected, bool $external): void {
+    config(['announce.external_tracker.is_enabled' => $external]);
+    highspeedSeedbox($ip);
+    highspeedPeer(ipv6Age: $age);
+    $before = DB::table('torrents')->find(12001);
+    expect(app(Kernel::class)->call('auto:highspeed_tag'))->toBe(0);
+    $after = DB::table('torrents')->find(12001);
+    expect((bool) $after->highspeed)->toBe($expected)
+        ->and($after->updated_at)->toBe($before->updated_at)
+        ->and($after->seeders)->toBe($before->seeders)
+        ->and(DB::table('peer_ips')->count())->toBe(2)
+        ->and((bool) DB::table('torrents')->where('id', 12002)->value('highspeed'))->toBeFalse();
+})->with([
+    'ipv4 vigente'         => ['192.0.2.30', 0, true],
+    'ipv6 vigente'         => ['2001:db8::30', 0, true],
+    'ipv6 antes do limite' => ['2001:db8::30', 7199, true],
+    'ipv6 no limite'       => ['2001:db8::30', 7200, false],
+    'ipv6 expirado'        => ['2001:db8::30', 7201, false],
+    'projecao obsoleta'    => ['192.0.2.199', 0, false],
+    'cadastro invalido'    => ['not-an-ip', 0, false],
+])->with(['standalone' => false, 'externo' => true]);
+
+it('nao usa endpoints de outra identidade ou seeder inelegivel', function (array $overrides): void {
+    highspeedSeedbox('2001:db8::30');
+    highspeedPeer();
+    DB::table('peer_ips')->delete();
+    highspeedPeer($overrides);
+    expect(app(Kernel::class)->call('auto:highspeed_tag'))->toBe(0);
+    expect((bool) DB::table('torrents')->where('id', 12001)->value('highspeed'))->toBeFalse();
+})->with([
+    'outro torrent'         => [['torrent_id' => 12002]],
+    'outro usuario inativo' => [['user_id' => 12002, 'active' => false]],
+    'outro peer leecher'    => [['peer_id' => str_repeat('L', 20), 'seeder' => false, 'left' => 100]],
+]);
+
+it('preserva modo legado e nao exige schema expandido', function (): void {
+    config(['dualstack.enabled' => false]);
+    highspeedSeedbox('192.0.2.199');
+    highspeedPeer();
+    DB::table('peer_ips')->delete();
+    DB::enableQueryLog();
+    DB::flushQueryLog();
+    expect(app(Kernel::class)->call('auto:highspeed_tag'))->toBe(0);
+    expect((bool) DB::table('torrents')->where('id', 12001)->value('highspeed'))->toBeTrue();
+    expect(collect(DB::getQueryLog())->contains(fn ($query) => str_contains($query['query'], 'peer_ips')))->toBeFalse();
+});
+
+it('remove marca sem seedboxes e respeita ttl configurado', function (): void {
+    highspeedPeer(ipv6Age: 300);
+    expect(app(Kernel::class)->call('auto:highspeed_tag'))->toBe(0);
+    expect(DB::table('torrents')->where('highspeed', true)->count())->toBe(0);
+    highspeedSeedbox('2001:db8::30');
+    config(['dualstack.endpoint_ttl' => 300]);
+    app(Kernel::class)->call('auto:highspeed_tag');
+    expect((bool) DB::table('torrents')->where('id', 12001)->value('highspeed'))->toBeFalse();
+});
+
+it('processa fronteira de lotes preservando exclusao logica e status', function (): void {
+    expect(DB::table('torrents')->whereBetween('id', [20001, 20501])->exists())->toBeFalse();
+    $template = (array) DB::table('torrents')->find(12001);
+
+    foreach (range(20001, 20501) as $id) {
+        DB::table('torrents')->insert(array_replace($template, ['id' => $id, 'info_hash' => sha1('highspeed-'.$id, true), 'highspeed' => true]));
+    }
+    highspeedSeedbox('2001:db8::30');
+
+    foreach ([20001, 20500, 20501] as $id) {
+        highspeedPeer(['torrent_id' => $id]);
+    }
+    DB::table('torrents')->where('id', 20500)->update(['status' => 0]);
+    DB::table('torrents')->where('id', 20002)->update(['deleted_at' => now()]);
+    DB::enableQueryLog();
+    DB::flushQueryLog();
+    expect(app(Kernel::class)->call('auto:highspeed_tag'))->toBe(0);
+    $writes = collect(DB::getQueryLog())->filter(fn ($query) => str_starts_with(strtoupper($query['query']), 'UPDATE'));
+    expect($writes)->toHaveCount(2);
+
+    foreach ($writes as $write) {
+        expect(strtolower($write['query']))->not->toContain('join')->not->toContain('peers');
+    }
+    expect(DB::table('torrents')->whereBetween('id', [20001, 20501])->where('highspeed', true)->orderBy('id')->pluck('id')->all())
+        ->toBe([20001, 20002, 20500, 20501]);
+});
diff --git a/tests/Integration/DualstackHistoryContractTest.php b/tests/Integration/DualstackHistoryContractTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..43a3cbb75f25811b55c9bdb1ae4f34e92b9b418d
--- /dev/null
+++ b/tests/Integration/DualstackHistoryContractTest.php
@@ -0,0 +1,97 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Services\Dualstack\TrackerLease;
+use App\Services\Dualstack\TransitionJournal;
+use App\Services\Dualstack\TransitionWriter;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+
+beforeAll(function (): void {
+    $app = require __DIR__.'/../../bootstrap/app.php';
+    $app->make(Kernel::class)->bootstrap();
+});
+
+beforeEach(function (): void {
+    if (getenv('DUALSTACK_HISTORY_TESTS') !== '1') {
+        $this->markTestSkipped('Exige MySQL/Redis reais, banco unit3d_dualstack_journal_test e DUALSTACK_HISTORY_TESTS=1.');
+    }
+    expect(DB::getDriverName())->toBe('mysql')->and(DB::getDatabaseName())->toBe('unit3d_dualstack_journal_test');
+    expect(DB::selectOne('SELECT @@transaction_isolation AS level')->level)->toBe('REPEATABLE-READ');
+    expect((int) DB::selectOne('SELECT @@innodb_lock_wait_timeout AS seconds')->seconds)->toBe(10);
+    expect(DB::table('tracker_ownership')->whereRaw('lease_expires_at > UTC_TIMESTAMP(3)')->exists())->toBeFalse();
+    DB::table('peers')->delete();
+    DB::table('history')->delete();
+    DB::table('users')->update(['uploaded' => 0, 'downloaded' => 0]);
+    DB::table('torrents')->update(array_fill_keys(['seeders', 'leechers', 'seeders_ipv4', 'seeders_ipv6', 'leechers_ipv4', 'leechers_ipv6', 'times_completed'], 0));
+    config(['cache.prefix' => 'dualstack-history-test:'.bin2hex(random_bytes(8)), 'dualstack.allow_private_addresses' => true]);
+    $this->policy = ['endpoint_ttl' => 7200, 'max_endpoints' => 2, 'max_peers' => 3, 'min_interval' => 0,
+        'allow_private_addresses'   => true, 'require_connectivity' => false, 'max_pending_transitions' => 1000];
+    $this->credit = ['upload_percent' => 100, 'download_percent' => 100, 'immune' => false];
+    $this->identity = ['user_id' => 12001, 'torrent_id' => 12001, 'peer_id' => bin2hex(str_repeat('J', 20))];
+    $this->request = ['event' => 'started', 'ip' => '172.29.92.30', 'port' => 6881, 'uploaded' => '1000', 'downloaded' => '0', 'left' => '100', 'visible' => true, 'agent' => 'dualstack-journal-test'];
+    $this->lease = TrackerLease::acquire();
+    $this->writer = new TransitionWriter($this->lease);
+    $this->writer->prepare();
+    $this->lease->ready(true);
+    $this->journal = new TransitionJournal($this->lease);
+});
+
+it('executa contrato compartilhado de historico e seedtime sem multiplicar familias', function (): void {
+    $contract = json_decode(file_get_contents('/lab/fixtures/history-v1.json'), true, flags: JSON_THROW_ON_ERROR);
+    $this->policy['endpoint_ttl'] = $contract['endpoint_ttl'];
+    $this->policy['seedtime_max_interval'] = $contract['seedtime_max_interval'];
+    $base = (int) Redis::connection('announce')->time()[0];
+
+    foreach ($contract['operations'] as $step => $operation) {
+        $id = array_replace($this->identity, ['peer_id' => bin2hex(str_repeat($operation['peer'], 20))]);
+        $kind = $operation['kind'] ?? 'announce';
+        $family = $operation['family'] ?? 4;
+        $request = array_replace($this->request, [
+            'kind'  => $kind, 'ip' => $family === 4 ? '172.29.92.30' : 'fd42:756e:6974:92::30',
+            'event' => $operation['event'] ?? '', 'left' => $operation['left'] ?? '0',
+            'port'  => ($operation['event'] ?? '') === 'stopped' ? 0 : 6881,
+        ]);
+
+        if ($kind === 'probe') {
+            $request['revision'] = (int) DB::table('peer_ips')->where('peer_id', hex2bin($id['peer_id']))->where('family', $family)->value('revision');
+            $request['connectable'] = true;
+        }
+        $result = $this->journal->publish($id, $request, $this->policy, $this->credit, $base + $operation['at']);
+        expect($result['outcome'])->toBe(($operation['ignored'] ?? false) ? 'ignored' : 'accepted');
+        $messages = $this->writer->read('history-contract');
+        $this->writer->persist($messages);
+        expect($this->writer->persist($messages))->toBe(0);
+        $this->writer->acknowledge(array_keys($messages));
+        $history = DB::table('history')->where('user_id', 12001)->where('torrent_id', 12001)->first();
+        $torrent = DB::table('torrents')->find(12001);
+        expect((int) $history->seedtime)->toBe($operation['seedtime'], 'step '.$step)
+            ->and((bool) $history->active)->toBe($operation['seeders'] + $operation['leechers'] > 0)
+            ->and((bool) $history->seeder)->toBe($operation['seeders'] > 0)
+            ->and((int) $torrent->seeders)->toBe($operation['seeders'])
+            ->and((int) $torrent->leechers)->toBe($operation['leechers'])
+            ->and((int) $torrent->times_completed)->toBe($operation['completed'])
+            ->and(DB::table('peer_ips')->count())->toBe($operation['endpoints'])
+            ->and(DB::table('history')->count())->toBe(1)
+            ->and((string) DB::table('users')->where('id', 12001)->value('uploaded'))->toBe('0');
+    }
+});
+
+afterEach(function (): void {
+    if (getenv('DUALSTACK_HISTORY_TESTS') !== '1' || !isset($this->lease)) {
+        return;
+    }
+    $this->lease->release();
+    $redis = Redis::connection('announce');
+    $cursor = '0';
+
+    do {
+        [$cursor, $keys] = $redis->command('rawCommand', ['SCAN', $cursor, 'MATCH', TrackerLease::base().':*', 'COUNT', 1000]);
+
+        if ($keys !== []) {
+            $redis->command('rawCommand', ['UNLINK', ...$keys]);
+        }
+    } while ((string) $cursor !== '0');
+});
