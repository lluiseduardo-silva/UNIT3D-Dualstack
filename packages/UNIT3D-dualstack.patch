diff --git a/tests/Integration/DownloadRefundContentionTest.php b/tests/Integration/DownloadRefundContentionTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..99ae9029ae28b3fe4be3f5b25c5ee74dd70b2e7d
--- /dev/null
+++ b/tests/Integration/DownloadRefundContentionTest.php
@@ -0,0 +1,212 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Services\DownloadRefund;
+use App\Services\Dualstack\TrackerLease;
+use App\Services\Dualstack\TransitionJournal;
+use App\Services\Dualstack\TransitionWriter;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+
+beforeAll(function (): void {
+    $app = require __DIR__.'/../../bootstrap/app.php';
+    $app->make(Kernel::class)->bootstrap();
+});
+
+it('preserva reembolsos e trafego com dezesseis processos sobre as mesmas chaves', function (): void {
+    if (getenv('DUALSTACK_REFUND_CONTENTION_TESTS') !== '1' || !\function_exists('pcntl_fork')) {
+        $this->markTestSkipped('Exige MySQL/Redis reais, pcntl e banco isolado de dualstack.');
+    }
+    expect(DB::getDatabaseName())->toBe('unit3d_dualstack_journal_test')
+        ->and(DB::selectOne('SELECT @@transaction_isolation AS level')->level)->toBe('REPEATABLE-READ')
+        ->and((int) DB::selectOne('SELECT @@innodb_lock_wait_timeout AS seconds')->seconds)->toBe(10)
+        ->and(DB::table('tracker_ownership')->whereRaw('lease_expires_at > UTC_TIMESTAMP(3)')->exists())->toBeFalse();
+    $metrics = fn () => DB::table('information_schema.INNODB_METRICS')
+        ->whereIn('NAME', ['lock_deadlocks', 'lock_timeouts', 'lock_row_lock_waits', 'lock_row_lock_time'])
+        ->pluck('COUNT', 'NAME')->map(fn ($n) => (int) $n)->all();
+    $before = $metrics();
+    $users = DB::table('users')->whereIn('id', [12001, 12002, 12003])->get(['id', 'downloaded', 'uploaded', 'group_id'])->all();
+    $torrents = DB::table('torrents')->whereIn('id', [12001, 12002])->get(['id', 'size', 'user_id'])->all();
+    DB::table('peers')->delete();
+    DB::table('history')->delete();
+    DB::table('users')->whereIn('id', [12001, 12002, 12003])->update(['downloaded' => 1000000, 'uploaded' => 0, 'group_id' => DB::table('groups')->orderBy('id')->value('id')]);
+    // The uploader cannot also be a refund recipient.
+    DB::table('torrents')->whereIn('id', [12001, 12002])->update(['size' => 1000, 'user_id' => 1]);
+    config(['cache.prefix'                  => 'refund-contention:'.bin2hex(random_bytes(8)), 'dualstack.enabled' => true,
+        'dualstack.allow_private_addresses' => true, 'other.refundable' => true, 'hitrun.seedtime' => 3600]);
+    $lease = TrackerLease::acquire();
+    $writer = new TransitionWriter($lease);
+    $writer->prepare();
+    $lease->ready(true);
+    $journal = new TransitionJournal($lease);
+    $policy = ['endpoint_ttl'     => 7200, 'max_endpoints' => 2, 'max_peers' => 3, 'min_interval' => 0,
+        'allow_private_addresses' => true, 'require_connectivity' => false, 'max_pending_transitions' => 2000];
+    $credit = ['upload_percent' => 100, 'download_percent' => 100, 'immune' => false];
+    $request = ['event' => '', 'ip' => '192.0.2.30', 'port' => 6881, 'uploaded' => '1000', 'downloaded' => '1000', 'left' => '0', 'visible' => true, 'agent' => 'refund-contention'];
+    $children = $gates = $files = [];
+
+    try {
+        foreach ([12001, 12002, 12003] as $user) {
+            foreach ([12001, 12002] as $torrent) {
+                $identity = ['user_id' => $user, 'torrent_id' => $torrent, 'peer_id' => bin2hex(str_repeat('F', 20))];
+
+                foreach (['192.0.2.30', '2001:db8::30'] as $ip) {
+                    expect($journal->publish($identity, array_replace($request, ['ip' => $ip]), $policy, $credit)['outcome'])->toBe('accepted');
+                }
+            }
+        }
+        $writer->flush('setup');
+        DB::table('history')->update(['seedtime' => 12 * 30 * 24 * 60 * 60 + 3600, 'created_at' => now()->subDays(2)]);
+
+        foreach (range(1, 100) as $step) {
+            foreach ([12001, 12002, 12003] as $user) {
+                foreach ([12001, 12002] as $torrent) {
+                    $identity = ['user_id' => $user, 'torrent_id' => $torrent, 'peer_id' => bin2hex(str_repeat('F', 20))];
+                    expect($journal->publish($identity, array_replace($request, ['ip' => $step % 2 ? '192.0.2.30' : '2001:db8::30',
+                        'uploaded'                                                    => (string) (1000 + $step * 100), 'downloaded' => (string) (1000 + $step * 100)]), $policy, $credit)['outcome'])->toBe('accepted');
+                }
+            }
+        }
+        $messages = $writer->read('dispatch', 1000);
+        expect($messages)->toHaveCount(600);
+        $lease->renew();
+        DB::disconnect();
+        Redis::purge('announce');
+
+        for ($worker = 0; $worker < 16; $worker++) {
+            $files[$worker] = tempnam(sys_get_temp_dir(), 'refund-worker-');
+            $sockets = stream_socket_pair(STREAM_PF_UNIX, STREAM_SOCK_STREAM, STREAM_IPPROTO_IP);
+            $pid = pcntl_fork();
+
+            if ($pid === -1 || $sockets === false) {
+                throw new RuntimeException('Falha ao criar processos reais.');
+            }
+
+            if ($pid === 0) {
+                fclose($sockets[0]);
+
+                try {
+                    if (fread($sockets[1], 1) !== 'G') {
+                        exit(1);
+                    }
+                    $started = microtime(true);
+
+                    if ($worker < 8) {
+                        foreach ($messages as $id => $message) {
+                            $writer->persist([$id => $message]);
+                        }
+                    } else {
+                        for ($iteration = 0; $iteration < 20; $iteration++) {
+                            app(DownloadRefund::class)->run();
+                        }
+                    }
+                    file_put_contents($files[$worker], json_encode(['worker' => $worker, 'seconds' => microtime(true) - $started]));
+
+                    exit(0);
+                } catch (Throwable $error) {
+                    fwrite(STDERR, 'Refund contention: '.$error::class.' code '.$error->getCode().' at '.basename($error->getFile()).':'.$error->getLine()."\n");
+
+                    exit(1);
+                }
+            }
+            fclose($sockets[1]);
+            $children[] = $pid;
+            $gates[] = $sockets[0];
+        }
+        DB::beginTransaction();
+        DB::table('users')->whereIn('id', [12001, 12002, 12003])->orderBy('id')->lockForUpdate()->get(['id']);
+
+        foreach ($gates as $gate) {
+            fwrite($gate, 'G');
+            fclose($gate);
+        }
+        $gates = [];
+        $deadline = microtime(true) + 5;
+
+        do {
+            $waiting = (int) DB::table('information_schema.INNODB_METRICS')->where('NAME', 'lock_row_lock_current_waits')->value('COUNT');
+
+            if ($waiting >= 16) {
+                break;
+            }
+            usleep(20000);
+        } while (microtime(true) < $deadline);
+        DB::commit();
+        $deadline = microtime(true) + 120;
+        $renewAt = 0;
+
+        while ($children !== []) {
+            foreach ($children as $key => $pid) {
+                if (pcntl_waitpid($pid, $status, WNOHANG) > 0) {
+                    unset($children[$key]);
+                    expect(pcntl_wifexited($status))->toBeTrue()->and(pcntl_wexitstatus($status))->toBe(0);
+                }
+            }
+            expect(microtime(true))->toBeLessThan($deadline);
+
+            if (microtime(true) >= $renewAt) {
+                $lease->renew();
+                $renewAt = microtime(true) + 3;
+            }
+            usleep(20000);
+        }
+        $writer->acknowledge(array_keys($messages));
+        $after = $metrics();
+        $credits = DB::table('users')->whereIn('id', [12001, 12002, 12003])->orderBy('id')->get(['id', 'uploaded', 'downloaded'])->all();
+
+        foreach ($credits as $row) {
+            expect((int) $row->uploaded)->toBe(20000)->and((int) $row->downloaded)->toBe(1018000);
+        }
+        fwrite(STDOUT, "\nrefund contention ".json_encode(['sql_writers' => 16, 'waiting' => $waiting,
+            'unique_transitions'                                         => 600, 'persistence_attempts' => 4800, 'refund_commands' => 160,
+            'before'                                                     => $before, 'after' => $after, 'credits' => $credits,
+            'workers'                                                    => array_map(fn ($path) => json_decode(file_get_contents($path), true), $files)])."\n");
+        expect($waiting)->toBeGreaterThanOrEqual(16)->and($after['lock_deadlocks'])->toBe($before['lock_deadlocks'])
+            ->and($after['lock_timeouts'])->toBe($before['lock_timeouts'])
+            ->and((int) DB::table('history')->sum('refunded_download'))->toBe(6000)
+            ->and(DB::table('peers')->count())->toBe(6)->and(DB::table('peer_ips')->count())->toBe(12)
+            ->and((int) Redis::connection('announce')->xLen(TrackerLease::base().':transitions'))->toBe(0);
+    } finally {
+        if (DB::transactionLevel() > 0) {
+            DB::rollBack();
+        }
+
+        foreach ($gates as $gate) {
+            fclose($gate);
+        }
+
+        foreach ($children as $pid) {
+            posix_kill($pid, SIGTERM);
+            pcntl_waitpid($pid, $status);
+        }
+        $lease->release();
+        // Remove only this test's private, drained namespace. Keep pending evidence on failure.
+        $redis = Redis::connection('announce');
+
+        if ((int) $redis->xLen(TrackerLease::base().':transitions') === 0) {
+            $cursor = '0';
+
+            do {
+                [$cursor, $keys] = $redis->command('rawCommand', ['SCAN', $cursor, 'MATCH', TrackerLease::base().':*', 'COUNT', 1000]);
+
+                if ($keys !== []) {
+                    $redis->command('rawCommand', ['UNLINK', ...$keys]);
+                }
+            } while ((string) $cursor !== '0');
+        }
+
+        foreach ($files as $file) {
+            unlink($file);
+        }
+
+        foreach ($users as $user) {
+            DB::table('users')->where('id', $user->id)->update((array) $user);
+        }
+
+        foreach ($torrents as $torrent) {
+            DB::table('torrents')->where('id', $torrent->id)->update((array) $torrent);
+        }
+    }
+});
diff --git a/tests/Integration/DownloadRefundTest.php b/tests/Integration/DownloadRefundTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..76a127df62e96e23b46d7d0bb2fcb67988d9272a
--- /dev/null
+++ b/tests/Integration/DownloadRefundTest.php
@@ -0,0 +1,175 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Services\DownloadRefund;
+use Illuminate\Contracts\Console\Kernel;
+use Illuminate\Database\Events\QueryExecuted;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\DB;
+
+beforeAll(function (): void {
+    $app = require __DIR__.'/../../bootstrap/app.php';
+    $app->make(Kernel::class)->bootstrap();
+});
+
+beforeEach(function (): void {
+    if (getenv('DUALSTACK_CONSUMER_TESTS') !== '1') {
+        $this->markTestSkipped('Exige MySQL real e banco isolado de dualstack.');
+    }
+    expect(DB::getDriverName())->toBe('mysql')->and(DB::getDatabaseName())->toBe('unit3d_dualstack_journal_test');
+    expect(DB::table('tracker_ownership')->whereRaw('lease_expires_at > UTC_TIMESTAMP(3)')->exists())->toBeFalse();
+    Carbon::setTestNow('2026-10-08 12:00:00');
+    config(['other.refundable' => true, 'hitrun.seedtime' => 3600]);
+    DB::table('peers')->delete();
+    DB::table('history')->delete();
+    $this->savedUsers = DB::table('users')->whereIn('id', [12001, 12002])->get(['id', 'downloaded', 'group_id'])->all();
+    $this->savedTorrent = (array) DB::table('torrents')->find(12001);
+    $group = DB::table('groups')->orderBy('id')->value('id');
+    DB::table('users')->whereIn('id', [12001, 12002])->update(['downloaded' => 1000000, 'group_id' => $group]);
+    DB::table('torrents')->where('id', 12001)->update(['size' => 1000, 'user_id' => 12003, 'refundable' => true]);
+    $this->full = 12 * 30 * 24 * 60 * 60 + 3600;
+});
+
+afterEach(function (): void {
+    Carbon::setTestNow();
+
+    if (!isset($this->savedUsers)) {
+        return;
+    }
+    DB::table('history')->delete();
+    DB::table('torrents')->whereBetween('id', [16000, 16200])->delete();
+    DB::table('torrents')->where('id', 12001)->update($this->savedTorrent);
+
+    foreach ($this->savedUsers as $user) {
+        DB::table('users')->where('id', $user->id)->update((array) $user);
+    }
+});
+
+function refundHistory(int $torrent, int $seedtime, int $user = 12001): void
+{
+    DB::table('history')->insert(['user_id' => $user, 'torrent_id' => $torrent, 'agent' => 'refund-test',
+        'client_uploaded'                   => 0, 'client_downloaded' => 1000, 'active' => true, 'seeder' => true, 'immune' => false,
+        'seedtime'                          => $seedtime, 'created_at' => now()->subDays(2), 'updated_at' => now()->subHour()]);
+}
+
+it('usa os mesmos bytes inteiros nos dois lados e preserva timestamps', function (int $size, int $expected): void {
+    DB::table('torrents')->where('id', 12001)->update(['size' => $size]);
+    refundHistory(12001, intdiv($this->full, 2));
+    $timestamp = DB::table('history')->value('updated_at');
+    app(DownloadRefund::class)->run();
+    expect((string) DB::table('history')->value('refunded_download'))->toBe((string) $expected)
+        ->and((string) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe((string) max(0, 1000000 - $expected))
+        ->and(DB::table('history')->value('updated_at'))->toBe($timestamp);
+    app(DownloadRefund::class)->run();
+    expect((string) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe((string) max(0, 1000000 - $expected));
+})->with([[1, 1], [3, 2], [5, 3], [1000, 500], [9007199254740992, 4503599627370496]]);
+
+it('soma deltas de usuarios separados e preserva correcao negativa da referencia', function (): void {
+    refundHistory(12001, $this->full);
+    refundHistory(12001, $this->full, 12002);
+    DB::table('history')->where('user_id', 12001)->update(['refunded_download' => 1500]);
+    app(DownloadRefund::class)->run();
+    expect((int) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe(1000500)
+        ->and((int) DB::table('users')->where('id', 12002)->value('downloaded'))->toBe(999000)
+        ->and((int) DB::table('history')->sum('refunded_download'))->toBe(2000);
+});
+
+it('preserva filtros de elegibilidade', function (string $filter): void {
+    refundHistory(12001, $this->full);
+    match ($filter) {
+        'inactive' => DB::table('history')->update(['active' => false]),
+        'leecher'  => DB::table('history')->update(['seeder' => false]),
+        'young'    => DB::table('history')->update(['created_at' => now()]),
+        'minimum'  => DB::table('history')->update(['seedtime' => 3599]),
+        'maximum'  => DB::table('history')->update(['seedtime' => $this->full + 3600 + 86401]),
+        'deleted'  => DB::table('history')->update(['deleted_at' => now()]),
+        'uploader' => DB::table('torrents')->where('id', 12001)->update(['user_id' => 12001]),
+    };
+    app(DownloadRefund::class)->run();
+    expect((int) DB::table('history')->sum('refunded_download'))->toBe(0)
+        ->and((int) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe(1000000);
+})->with(['inactive', 'leecher', 'young', 'minimum', 'maximum', 'deleted', 'uploader']);
+
+it('respeita configuracao e permissao de reembolso do grupo ou torrent', function (): void {
+    refundHistory(12001, $this->full);
+    config(['other.refundable' => false]);
+    $group = DB::table('users')->where('id', 12001)->value('group_id');
+    $old = DB::table('groups')->where('id', $group)->value('is_refundable');
+
+    try {
+        DB::table('groups')->where('id', $group)->update(['is_refundable' => false]);
+        DB::table('torrents')->where('id', 12001)->update(['refundable' => false]);
+        app(DownloadRefund::class)->run();
+        expect((int) DB::table('history')->value('refunded_download'))->toBe(0);
+        DB::table('groups')->where('id', $group)->update(['is_refundable' => true]);
+        app(DownloadRefund::class)->run();
+        expect((int) DB::table('history')->value('refunded_download'))->toBe(1000);
+    } finally {
+        DB::table('groups')->where('id', $group)->update(['is_refundable' => $old]);
+    }
+});
+
+it('limita lotes mesmo para um usuario e retoma falha entre saldo e historico', function (string $failure): void {
+    $torrent = $this->savedTorrent;
+
+    foreach (range(16000, 16200) as $id) {
+        DB::table('torrents')->insert(array_replace($torrent, ['id' => $id, 'info_hash' => hex2bin(sha1('refund-'.$id)), 'size' => 1000, 'user_id' => 12003]));
+        refundHistory($id, $this->full);
+    }
+    $writes = 0;
+    $listening = true;
+    DB::listen(function (QueryExecuted $query) use (&$writes, &$listening, $failure): void {
+        if (!$listening || !str_starts_with($query->sql, 'UPDATE ') || !str_contains($query->sql, 'AS refunds ON')) {
+            return;
+        }
+        $writes++;
+        expect(\count($query->bindings))->toBeLessThanOrEqual(300);
+
+        if ($writes === 2 && $failure !== 'none') {
+            if ($failure === 'retry') {
+                throw new PDOException('Deadlock found when trying to get lock; try restarting transaction', 40001);
+            }
+
+            throw new RuntimeException('REFUND_FAILURE_AFTER_BALANCE');
+        }
+    });
+
+    try {
+        if ($failure === 'rollback') {
+            expect(fn () => app(DownloadRefund::class)->run())->toThrow(RuntimeException::class, 'REFUND_FAILURE_AFTER_BALANCE');
+            expect((int) DB::table('history')->sum('refunded_download'))->toBe(100000)
+                ->and((int) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe(900000);
+        }
+        app(DownloadRefund::class)->run();
+        expect((int) DB::table('history')->sum('refunded_download'))->toBe(201000)
+            ->and((int) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe(799000)
+            ->and(DB::transactionLevel())->toBe(0)->and($writes)->toBe($failure === 'none' ? 3 : 4);
+        app(DownloadRefund::class)->run();
+        expect((int) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe(799000);
+    } finally {
+        $listening = false;
+    }
+})->with(['none', 'rollback', 'retry']);
+
+it('esgota o retry sem confirmar apenas o saldo', function (): void {
+    refundHistory(12001, $this->full);
+    $writes = 0;
+    $listening = true;
+    DB::listen(function (QueryExecuted $query) use (&$writes, &$listening): void {
+        if ($listening && str_starts_with($query->sql, 'UPDATE ') && str_contains($query->sql, 'AS refunds ON')) {
+            $writes++;
+
+            throw new PDOException('Deadlock found when trying to get lock; try restarting transaction', 40001);
+        }
+    });
+
+    try {
+        expect(fn () => app(DownloadRefund::class)->run())->toThrow(PDOException::class);
+        expect($writes)->toBe(5)->and(DB::transactionLevel())->toBe(0)
+            ->and((int) DB::table('history')->value('refunded_download'))->toBe(0)
+            ->and((int) DB::table('users')->where('id', 12001)->value('downloaded'))->toBe(1000000);
+    } finally {
+        $listening = false;
+    }
+});
