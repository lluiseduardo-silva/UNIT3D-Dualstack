@@ -0,0 +1,42 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use App\Models\User;
+use Illuminate\Pagination\LengthAwarePaginator;
+use Illuminate\Support\Collection;
+
+final class ProfileClients
+{
+    public static function get(User $user, User $viewer): Collection|LengthAwarePaginator
+    {
+        if (!$viewer->is($user) && !$viewer->group->is_modo) {
+            return collect();
+        }
+
+        $query = $user->peers()->join('torrents', 'torrents.id', '=', 'peers.torrent_id')
+            ->where('peers.active', true);
+
+        if (!config('dualstack.enabled')) {
+            return $query->select('agent', 'port')->selectRaw('INET6_NTOA(peers.ip) AS ip')
+                ->selectRaw('MIN(peers.created_at) AS created_at, MAX(peers.updated_at) AS updated_at')
+                ->selectRaw('SUM(torrents.size) AS size, COUNT(*) AS num_peers, MAX(peers.connectable) AS connectable')
+                ->groupBy(['ip', 'port', 'agent'])->get();
+        }
+
+        $page = $query->select(['peers.user_id', 'peers.torrent_id', 'peers.peer_id', 'peers.agent',
+            'peers.created_at', 'peers.updated_at', 'torrents.name as torrent_name', 'torrents.size'])
+            ->whereExists(fn ($endpoint) => $endpoint->selectRaw('1')->from('peer_ips')
+                ->whereColumn('peer_ips.user_id', 'peers.user_id')
+                ->whereColumn('peer_ips.torrent_id', 'peers.torrent_id')
+                ->whereColumn('peer_ips.peer_id', 'peers.peer_id')
+                ->where('last_announced_at', '>', now()->subSeconds((int) config('dualstack.endpoint_ttl'))))
+            ->orderByDesc('peers.updated_at')->orderBy('peers.torrent_id')->orderBy('peers.peer_id')
+            ->paginate(25, ['*'], 'clientsPage')->withQueryString();
+        EndpointView::load($page->getCollection());
+
+        return $page;
+    }
+}
diff --git a/app/Services/Dualstack/StandaloneAnnounce.php b/app/Services/Dualstack/StandaloneAnnounce.php
new file mode 100644
index 0000000000000000000000000000000000000000..ddc08ed0e76ad741de78cb93b0cc8d4dddd2ada9
--- /dev/null
+++ b/app/Services/Dualstack/StandaloneAnnounce.php
@@ -0,0 +1,56 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use App\DTO\AnnounceQueryDTO;
+use App\Exceptions\TrackerException;
+use App\Models\FeaturedTorrent;
+use App\Models\FreeleechToken;
+use App\Models\Group;
+use App\Models\PersonalFreeleech;
+use App\Models\Torrent;
+use App\Models\User;
+use Illuminate\Http\Request;
+
+final class StandaloneAnnounce
+{
+    public function handle(Request $request, AnnounceQueryDTO $queries, User $user, Group $group, Torrent $torrent): string
+    {
+        if (config('announce.external_tracker.is_enabled')) {
+            throw new TrackerException(100);
+        }
+        $policy = Policy::configured();
+
+        if (config('announce.slots_system.enabled')) {
+            $policy['download_slots'] = $group->download_slots;
+        }
+        $personal = cache()->rememberForever('personal_freeleech:'.$user->id, fn () => PersonalFreeleech::where('user_id', $user->id)->exists());
+        $token = cache()->rememberForever('freeleech_token:'.$user->id.':'.$torrent->id, fn () => FreeleechToken::where('user_id', $user->id)->where('torrent_id', $torrent->id)->exists());
+        $featured = \in_array($torrent->id, cache()->rememberForever('featured-torrent-ids', fn () => FeaturedTorrent::pluck('torrent_id')->all()), true);
+        $free = $personal || $token || $featured || $user->is_donor || $group->is_freeleech || config('other.freeleech');
+        $double = $torrent->doubleup || $group->is_double_upload || $featured || config('other.doubleup');
+        $ip = EndpointAddress::observed($request->getClientIp(), $policy['allow_private_addresses']);
+        $journal = new TransitionJournal(TrackerLease::current());
+        $result = $journal->publish(['user_id' => $user->id, 'torrent_id' => $torrent->id, 'peer_id' => bin2hex($queries->getPeerId())], [
+            'ip'         => $ip->text(), 'port' => $queries->port, 'event' => $queries->event, 'agent' => $queries->getAgent(),
+            'uploaded'   => Counter::of($request->query->getString('uploaded')),
+            'downloaded' => Counter::of($request->query->getString('downloaded')),
+            'left'       => Counter::of($request->query->getString('left')), 'visible' => true,
+        ], $policy, ['upload_percent' => $double ? 200 : 100, 'download_percent' => $free ? 0 : 100 - min(100, (int) $torrent->free),
+            'immune'                  => $user->is_donor || $group->is_immune]);
+
+        if ($result['outcome'] === 'rejected') {
+            throw match ($result['reason']) {
+                'removed'    => new TrackerException(100),
+                'interval'   => new TrackerException(162, [':elapsed' => 'less than the minimum']),
+                'peer_limit' => new TrackerException(138, [':limit' => $policy['max_peers']]),
+                default      => new TrackerException(131, [':attribute' => 'endpoint', ':reason' => 'IP family limit reached']),
+            };
+        }
+        $warning = ($result['peer']['visible'] ?? true) ? null : (new TrackerException(164, [':max' => $group->download_slots]))->getMessage();
+
+        return (new AnnounceResponse())->build($torrent->id, $user->id, $queries->left === 0, $queries->numwant, $queries->event === 'stopped', $warning);
+    }
+}
diff --git a/app/Services/Dualstack/TrackerLease.php b/app/Services/Dualstack/TrackerLease.php
new file mode 100644
index 0000000000000000000000000000000000000000..fc9c9a19d6e3222499a71f9e32468d8347ceb5bf
--- /dev/null
+++ b/app/Services/Dualstack/TrackerLease.php
@@ -0,0 +1,166 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+use Illuminate\Support\Str;
+use RuntimeException;
+
+final readonly class TrackerLease
+{
+    public function __construct(public int $generation, public string $ownerId)
+    {
+    }
+
+    public static function base(): string
+    {
+        return config('cache.prefix').':dualstack:v1';
+    }
+
+    public function prefix(): string
+    {
+        return self::base().':g:'.$this->generation;
+    }
+
+    public static function acquire(): self
+    {
+        $started = hrtime(true);
+        $lease = DB::transaction(function (): self {
+            $owner = DB::table('tracker_ownership')->where('id', 1)
+                ->selectRaw('*, lease_expires_at > UTC_TIMESTAMP(3) AS live')->lockForUpdate()->first();
+
+            if ($owner === null || $owner->live) {
+                throw new RuntimeException('O swarm ja possui proprietario ativo ou o schema esta incompleto.');
+            }
+
+            if ($owner->legacy_reconciliation_required) {
+                throw new RuntimeException('Reconciliacao legada pendente; execute dualstack:legacy reconcile --offline.');
+            }
+            $lease = new self((int) $owner->generation + 1, (string) Str::uuid());
+            DB::table('tracker_ownership')->where('id', 1)->update([
+                'generation'          => $lease->generation, 'owner_id' => $lease->ownerId, 'backend' => 'php',
+                'lease_expires_at'    => DB::raw('UTC_TIMESTAMP(3) + INTERVAL 30 SECOND'),
+                'php_journal_drained' => false,
+            ]);
+
+            return $lease;
+        }, 3);
+        $redis = Redis::connection('announce');
+        $published = $redis->eval(<<<'LUA'
+local generation = tonumber(redis.call('HGET', KEYS[1], 'generation') or '0')
+if generation > tonumber(ARGV[1]) then return 0 end
+if generation == tonumber(ARGV[1]) and redis.call('HGET', KEYS[1], 'owner_id') ~= ARGV[2] then return 0 end
+redis.call('HSET', KEYS[1], 'generation', ARGV[1], 'owner_id', ARGV[2], 'backend', 'php', 'ready', '0')
+return 1
+LUA, 1, self::base().':owner', $lease->generation, $lease->ownerId);
+
+        if ($published !== 1) {
+            throw new RuntimeException('A geracao foi substituida antes da inicializacao.');
+        }
+        $lease->heartbeat($started);
+
+        return $lease;
+    }
+
+    public static function current(): self
+    {
+        $owner = Redis::connection('announce')->hGetAll(self::base().':owner');
+
+        if (($owner['backend'] ?? null) !== 'php' || !isset($owner['generation'], $owner['owner_id'])) {
+            throw new RuntimeException('Proprietario PHP indisponivel.');
+        }
+
+        return new self((int) $owner['generation'], $owner['owner_id']);
+    }
+
+    public function renew(): void
+    {
+        $started = hrtime(true);
+        $changed = DB::table('tracker_ownership')->where('id', 1)->where('owner_id', $this->ownerId)
+            ->where('generation', $this->generation)->whereRaw('lease_expires_at > UTC_TIMESTAMP(3)')
+            ->update(['lease_expires_at' => DB::raw('UTC_TIMESTAMP(3) + INTERVAL 30 SECOND')]);
+
+        if ($changed !== 1) {
+            throw new RuntimeException('Propriedade do swarm perdida; novas transicoes foram interrompidas.');
+        }
+        $this->heartbeat($started);
+    }
+
+    private function heartbeat(int $started): void
+    {
+        $ttl = 10000 - (int) ceil((hrtime(true) - $started) / 1e6);
+
+        if ($ttl <= 0) {
+            throw new RuntimeException('Renovacao demorou alem da margem segura da lease.');
+        }
+        $result = Redis::connection('announce')->eval(<<<'LUA'
+if redis.call('HGET', KEYS[1], 'owner_id') ~= ARGV[1] then return 0 end
+redis.call('SET', KEYS[2], ARGV[1], 'PX', ARGV[2])
+return 1
+LUA, 2, self::base().':owner', self::base().':heartbeat', $this->ownerId, $ttl);
+
+        if ($result !== 1) {
+            throw new RuntimeException('Geracao de proprietario substituida durante renovacao.');
+        }
+    }
+
+    public function ready(bool $ready): void
+    {
+        $result = Redis::connection('announce')->eval(<<<'LUA'
+if redis.call('HGET', KEYS[1], 'owner_id') ~= ARGV[1] or redis.call('GET', KEYS[2]) ~= ARGV[1] then return 0 end
+redis.call('HSET', KEYS[1], 'ready', ARGV[2])
+return 1
+LUA, 2, self::base().':owner', self::base().':heartbeat', $this->ownerId, $ready ? '1' : '0');
+
+        if ($result !== 1) {
+            throw new RuntimeException('Nao foi possivel confirmar a disponibilidade do proprietario.');
+        }
+    }
+
+    /** Chamar dentro da transacao, antes dos locks de usuarios e torrents. */
+    public function assertPersistable(): void
+    {
+        $owner = DB::table('tracker_ownership')->where('id', 1)
+            ->selectRaw('*, lease_expires_at > UTC_TIMESTAMP(3) AS live')->sharedLock()->first();
+
+        if ($owner === null || !$owner->live || $owner->owner_id !== $this->ownerId || (int) $owner->generation !== $this->generation) {
+            throw new RuntimeException('Lote recusado: proprietario ou geracao expirados.');
+        }
+    }
+
+    public function release(): void
+    {
+        // Fecha todos os produtores antes de certificar a fila vazia, atomicamente.
+        $drained = Redis::connection('announce')->eval(
+            <<<'LUA'
+if redis.call('HGET', KEYS[1], 'owner_id') ~= ARGV[1] then return 0 end
+redis.call('HSET', KEYS[1], 'ready', '0')
+redis.call('DEL', KEYS[2])
+if redis.call('XLEN', KEYS[3]) ~= 0 or redis.call('LLEN', KEYS[4]) ~= 0 or redis.call('LLEN', KEYS[5]) ~= 0 then return 0 end
+return 1
+LUA,
+            5,
+            self::base().':owner',
+            self::base().':heartbeat',
+            self::base().':transitions',
+            config('cache.prefix').':peers:batch',
+            config('cache.prefix').':histories:batch',
+            $this->ownerId
+        );
+        DB::transaction(function () use ($drained): void {
+            // A admissao de limpezas usa o mesmo lock. Uma solicitacao concorrente
+            // nao pode entrar entre a certificacao da fila e a liberacao da lease.
+            $owner = DB::table('tracker_ownership')->where('id', 1)->lockForUpdate()->first();
+
+            if ($owner === null || $owner->owner_id !== $this->ownerId || (int) $owner->generation !== $this->generation) {
+                return;
+            }
+            $pending = DB::table('tracker_cleanup_requests')->exists();
+            DB::table('tracker_ownership')->where('id', 1)
+                ->update(['lease_expires_at' => null, 'php_journal_drained' => $drained === 1 && !$pending]);
+        }, 3);
+    }
+}
diff --git a/app/Services/Dualstack/TrackerRecovery.php b/app/Services/Dualstack/TrackerRecovery.php
new file mode 100644
index 0000000000000000000000000000000000000000..8ca0bca9b9526798bb3e38d5572cdddb3bd960cf
--- /dev/null
+++ b/app/Services/Dualstack/TrackerRecovery.php
@@ -0,0 +1,303 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Redis;
+use RuntimeException;
+
+/** Executar com a entrada fechada. SQL confirmado e journal precedem o cache. */
+final class TrackerRecovery
+{
+    public function __construct(private readonly TrackerLease $lease, private readonly array $policy)
+    {
+    }
+
+    public function restore(): array
+    {
+        $this->lease->ready(false);
+        $redis = Redis::connection('announce');
+        $memoryPolicy = $redis->command('rawCommand', ['CONFIG', 'GET', 'maxmemory-policy']);
+
+        if (($memoryPolicy[1] ?? null) !== 'noeviction') {
+            throw new RuntimeException('O Redis do journal exige maxmemory-policy=noeviction.');
+        }
+        $writer = new TransitionWriter($this->lease);
+        $writer->prepare();
+        $replayed = $this->drain($writer, true);
+        $this->clearCache($this->lease->prefix().':*');
+        DeletedEntities::restoreFences($this->lease);
+        $cursor = null;
+        $count = 0;
+        $groupKey = null;
+        $group = null;
+
+        do {
+            $this->lease->renew();
+            $query = DB::table('peers')->orderBy('user_id')->orderBy('torrent_id')->orderBy('peer_id')->limit(500);
+
+            if ($cursor !== null) {
+                $query->whereRaw('(user_id,torrent_id,peer_id) > (?,?,?)', $cursor);
+            }
+            $rows = $query->get();
+
+            if ($rows->isEmpty()) {
+                break;
+            }
+            $identities = $rows->map(fn ($peer) => [$peer->user_id, $peer->torrent_id, $peer->peer_id])->all();
+            $endpoints = TransitionWriter::tuples('peer_ips', ['user_id', 'torrent_id', 'peer_id'], $identities)->get()
+                ->groupBy(fn ($row) => $row->user_id.':'.$row->torrent_id.':'.bin2hex($row->peer_id));
+            $histories = TransitionWriter::tuples('history', ['user_id', 'torrent_id'], array_map(fn ($id) => \array_slice($id, 0, 2), $identities))->get()
+                ->keyBy(fn ($row) => $row->user_id.':'.$row->torrent_id);
+            $commands = [];
+
+            foreach ($rows as $row) {
+                $cursor = [$row->user_id, $row->torrent_id, $row->peer_id];
+                $key = $row->user_id.':'.$row->torrent_id.':'.bin2hex($row->peer_id);
+                $nextGroup = $row->user_id.':'.$row->torrent_id;
+
+                if ($nextGroup !== $groupKey) {
+                    if ($group !== null) {
+                        $commands[] = ['set', $this->lease->prefix().':history:'.$groupKey, json_encode($group, JSON_THROW_ON_ERROR)];
+                    }
+                    $groupKey = $nextGroup;
+                    $history = $histories[$groupKey] ?? null;
+                    $group = ['state_version' => (int) ($history->state_version ?? 0), 'peers' => [],
+                        'completed'           => ($history->completed_at ?? null) !== null,
+                        'last_at'             => self::time($history->swarm_updated_at ?? $history->updated_at ?? $row->updated_at)];
+                }
+                $state = self::peer($row, $endpoints[$key] ?? []);
+                $commands[] = ['set', $this->lease->prefix().':peer:'.$key, json_encode($state, JSON_THROW_ON_ERROR)];
+
+                if ($state['active']) {
+                    $lasts = array_column($state['endpoints'], 'last_announced_at');
+                    $expiry = max($lasts) + $this->policy['endpoint_ttl'];
+                    $group['peers'][bin2hex($row->peer_id)] = ['seeder' => $state['seeder'], 'expires_at' => $expiry];
+                    $commands[] = ['zadd', $this->lease->prefix().':expiry', min($lasts) + $this->policy['endpoint_ttl'], $key];
+
+                    if ($state['visible'] && !$state['seeder']) {
+                        $commands[] = ['zadd', $this->lease->prefix().':user-leechers:'.$row->user_id, $expiry, $key];
+                    }
+                }
+                $count++;
+            }
+            $redis->pipeline(function ($pipe) use ($commands): void {
+                foreach ($commands as $command) {
+                    $method = array_shift($command);
+                    $pipe->{$method}(...$command);
+                }
+            });
+        } while ($rows->count() === 500);
+
+        if ($group !== null) {
+            $redis->set($this->lease->prefix().':history:'.$groupKey, json_encode($group, JSON_THROW_ON_ERROR));
+        }
+        $this->lease->renew();
+        $this->reconcileCounts();
+        $expired = 0;
+
+        do {
+            $this->lease->renew();
+            $processed = $this->expire(200, true);
+            $expired += $processed;
+            $this->drain($writer, true);
+        } while ($processed === 200);
+        $this->lease->renew();
+        $this->clearCache(TrackerLease::base().':g:*', $this->lease->prefix().':');
+        $this->lease->renew();
+        $this->lease->ready(true);
+
+        return ['loaded_peers' => $count, 'replayed_transitions' => $replayed, 'expired_peers' => $expired];
+    }
+
+    public function drain(TransitionWriter $writer, bool $recovering): int
+    {
+        $started = hrtime(true);
+        $total = 0;
+
+        while ((int) Redis::connection('announce')->xLen(TrackerLease::base().':transitions') > 0) {
+            if ((hrtime(true) - $started) / 1e9 > 120) {
+                throw new RuntimeException('Drenagem excedeu 120 segundos; entrada permanece fechada.');
+            }
+            $this->lease->renew();
+            $messages = $writer->read('coordinator-'.$this->lease->ownerId, 200, $recovering ? 0 : 5000);
+
+            if ($messages === []) {
+                usleep(100000);
+
+                continue;
+            }
+            $writer->persist($messages, $recovering);
+            $writer->acknowledge(array_keys($messages));
+            $total += \count($messages);
+        }
+
+        return $total;
+    }
+
+    public function expire(int $limit = 200, bool $initializing = false): int
+    {
+        $redis = Redis::connection('announce');
+        $now = (int) $redis->time()[0];
+        $members = $redis->zRangeByScore($this->lease->prefix().':expiry', '-inf', (string) $now, ['limit' => [0, $limit]]);
+        $journal = new TransitionJournal($this->lease);
+
+        foreach ($members as $member) {
+            [$user, $torrent, $peer] = explode(':', $member);
+            $result = $journal->publish(
+                ['user_id' => (int) $user, 'torrent_id' => (int) $torrent, 'peer_id' => $peer],
+                ['kind' => 'expire'],
+                $this->policy,
+                ['upload_percent' => 100, 'download_percent' => 100, 'immune' => false],
+                initializing: $initializing
+            );
+
+            if ($result['outcome'] === 'ignored' || ($result['reason'] ?? null) === 'removed') {
+                // Um announce pode ter renovado a origem apos a leitura do ZSET.
+                $redis->eval(<<<'LUA'
+local deadline = redis.call('ZSCORE', KEYS[1], ARGV[1])
+if deadline and tonumber(deadline) <= tonumber(ARGV[2]) then redis.call('ZREM', KEYS[1], ARGV[1]) end
+return 1
+LUA, 1, $this->lease->prefix().':expiry', $member, $now);
+            }
+        }
+
+        return \count($members);
+    }
+
+    private function clearCache(string $pattern, ?string $exceptPrefix = null): void
+    {
+        $redis = Redis::connection('announce');
+        $cursor = '0';
+
+        do {
+            $this->lease->renew();
+            [$cursor, $keys] = $redis->command('rawCommand', ['SCAN', $cursor, 'MATCH', $pattern, 'COUNT', 1000]);
+
+            if ($exceptPrefix !== null) {
+                $keys = array_values(array_filter($keys, fn ($key) => !str_starts_with($key, $exceptPrefix)));
+            }
+
+            if ($keys !== []) {
+                $redis->command('rawCommand', ['UNLINK', ...$keys]);
+            }
+        } while ((string) $cursor !== '0');
+    }
+
+    /** Pausa curta somente quando ha peers a retirar; nenhuma referencia pendente e descartada. */
+    public function retire(int $limit = 200): int
+    {
+        $retention = (int) config('dualstack.inactive_peer_retention');
+
+        if ($retention < 7200) {
+            throw new RuntimeException('Retencao contabil deve ser de pelo menos 7200 segundos.');
+        }
+        $cutoff = gmdate('Y-m-d H:i:s', (int) Redis::connection('announce')->time()[0] - $retention);
+        $candidate = fn () => DB::table('peers')->where('active', false)->where('updated_at', '<', $cutoff);
+
+        if (!$candidate()->exists()) {
+            return 0;
+        }
+        $this->lease->ready(false);
+        $writer = new TransitionWriter($this->lease);
+        $this->drain($writer, true);
+        $this->lease->renew();
+        $identities = DB::transaction(function () use ($candidate, $limit): array {
+            $this->lease->assertPersistable();
+            $rows = $candidate()->orderBy('user_id')->orderBy('torrent_id')->orderBy('peer_id')->limit($limit)->lockForUpdate()
+                ->get(['user_id', 'torrent_id', 'peer_id']);
+
+            if ($rows->isNotEmpty()) {
+                TransitionWriter::tuples('peers', ['user_id', 'torrent_id', 'peer_id'], $rows->map(fn ($row) => [$row->user_id, $row->torrent_id, $row->peer_id])->all())->delete();
+            }
+
+            return $rows->all();
+        }, 3);
+        $redis = Redis::connection('announce');
+
+        foreach ($identities as $identity) {
+            $key = $identity->user_id.':'.$identity->torrent_id.':'.bin2hex($identity->peer_id);
+            $redis->eval(
+                <<<'LUA'
+redis.call('DEL', KEYS[1])
+redis.call('ZREM', KEYS[2], ARGV[1])
+redis.call('ZREM', KEYS[3], ARGV[1])
+local group = redis.call('GET', KEYS[4])
+if group and next(cjson.decode(group).peers) == nil then redis.call('DEL', KEYS[4]) end
+return 1
+LUA,
+                4,
+                $this->lease->prefix().':peer:'.$key,
+                $this->lease->prefix().':expiry',
+                $this->lease->prefix().':user-leechers:'.$identity->user_id,
+                $this->lease->prefix().':history:'.$identity->user_id.':'.$identity->torrent_id,
+                $key
+            );
+        }
+        // Qualquer falha anterior deixa a entrada fechada; restore() reconstrui
+        // o cache a partir do SQL antes de uma nova geracao voltar a aceitar.
+        $this->lease->renew();
+        $this->lease->ready(true);
+
+        return \count($identities);
+    }
+
+    private function reconcileCounts(): void
+    {
+        // Estado confirmado antes da limpeza temporal. As expiracoes a seguir
+        // registram a diferenca por versao e historico, sem subtrair duas vezes.
+        $connectivity = $this->policy['require_connectivity'] ? ' AND e.connectable=1' : '';
+        DB::transaction(function () use ($connectivity): void {
+            $this->lease->assertPersistable();
+            $columns = $sets = [];
+
+            foreach (['seeders' => 'p.seeder=1', 'leechers' => 'p.seeder=0'] as $name => $kind) {
+                foreach (['' => '', '_ipv4' => ' AND e.family=4', '_ipv6' => ' AND e.family=6'] as $suffix => $family) {
+                    $field = $name.$suffix;
+                    $columns[] = "SUM(({$kind}) AND EXISTS (SELECT 1 FROM peer_ips e WHERE e.user_id=p.user_id AND e.torrent_id=p.torrent_id AND e.peer_id=p.peer_id {$family} {$connectivity})) AS {$field}";
+                    $sets[] = "t.{$field}=COALESCE(c.{$field},0)";
+                }
+            }
+            DB::update('UPDATE torrents t LEFT JOIN (SELECT p.torrent_id,'.implode(',', $columns).' FROM peers p WHERE p.active=1 AND p.visible=1 GROUP BY p.torrent_id) c ON c.torrent_id=t.id SET '.implode(',', $sets));
+        }, 3);
+    }
+
+    private static function time(?string $value): int
+    {
+        return $value === null ? 0 : (int) strtotime($value.' UTC');
+    }
+
+    private static function peer(object $row, iterable $rows): array
+    {
+        $protocol = $row->protocol_state === null ? [] : json_decode($row->protocol_state, true, flags: JSON_THROW_ON_ERROR);
+        $endpoints = [];
+
+        if ($row->active) {
+            foreach ($rows as $endpoint) {
+                $ip = EndpointAddress::observed(inet_ntop($endpoint->ip), (bool) config('dualstack.allow_private_addresses'));
+                $endpoints[$ip->family] = ['family' => $ip->family, 'ip' => $ip->text(), 'port' => (int) $endpoint->port,
+                    'connectable'                   => $endpoint->connectable === null ? null : (bool) $endpoint->connectable,
+                    'last_announced_at'             => self::time($endpoint->last_announced_at), 'revision' => (int) $endpoint->revision,
+                    'connectivity_checked_at'       => $endpoint->connectivity_checked_at === null ? null : self::time($endpoint->connectivity_checked_at),
+                    'created_at'                    => self::time($endpoint->created_at)];
+            }
+
+            if ($endpoints === []) {
+                throw new RuntimeException('Peer ativo sem endpoint; execute e verifique o backfill antes de iniciar.');
+            }
+        }
+        ksort($endpoints);
+
+        return ['uploaded'        => (string) $row->uploaded, 'downloaded' => (string) $row->downloaded, 'left' => (string) $row->left,
+            'agent'               => $row->agent, 'visible' => (bool) $row->visible, 'active' => $endpoints !== [], 'seeder' => (bool) $row->seeder,
+            'connectable'         => \in_array(true, array_column($endpoints, 'connectable'), true),
+            'state_version'       => (int) $row->state_version, 'session_generation' => (int) $row->session_generation,
+            'completion_reported' => (bool) $row->completion_reported || ((int) $row->state_version === 0 && (bool) $row->seeder),
+            'created_at'          => self::time($row->created_at), 'updated_at' => self::time($row->updated_at),
+            'session_started_at'  => $protocol['session_started_at'] ?? self::time($row->created_at),
+            'last_announces'      => $protocol['last_announces'] ?? array_map(fn ($endpoint) => $endpoint['last_announced_at'], $endpoints),
+            'endpoints'           => $endpoints, 'legacy_endpoint' => ['ip' => inet_ntop($row->ip), 'port' => (int) $row->port]];
+    }
+}
diff --git a/app/Services/Dualstack/TransitionJournal.php b/app/Services/Dualstack/TransitionJournal.php
new file mode 100644
index 0000000000000000000000000000000000000000..99ac5390ef693d19b029ff1e65578e780ccd12b8
--- /dev/null
+++ b/app/Services/Dualstack/TransitionJournal.php
@@ -0,0 +1,174 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services\Dualstack;
+
+use Illuminate\Support\Facades\Redis;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use RuntimeException;
+
+/** CAS entre processos PHP: snapshot, efeitos e referencia entram juntos no Redis. */
+final class TransitionJournal
+{
+    public function __construct(private readonly TrackerLease $lease)
+    {
+    }
+
+    public static function identityKey(array $identity): string
+    {
+        if (($identity['user_id'] ?? 0) < 1 || ($identity['torrent_id'] ?? 0) < 1
+            || \strlen($identity['peer_id'] ?? '') !== 40 || !ctype_xdigit($identity['peer_id'])) {
+            throw new InvalidArgumentException('Identidade de peer invalida.');
+        }
+
+        return (int) $identity['user_id'].':'.(int) $identity['torrent_id'].':'.strtolower($identity['peer_id']);
+    }
+
+    public function keys(array $identity): array
+    {
+        $id = self::identityKey($identity);
+        $prefix = $this->lease->prefix();
+
+        return [$prefix.':peer:'.$id, $prefix.':history:'.$identity['user_id'].':'.$identity['torrent_id'],
+            $prefix.':user-version:'.$identity['user_id'], $prefix.':user-leechers:'.$identity['user_id'],
+            $prefix.':expiry', TrackerLease::base().':transitions', TrackerLease::base().':owner', TrackerLease::base().':heartbeat',
+            $prefix.':deleted-users', $prefix.':deleted-torrents'];
+    }
+
+    /** $clock e reservado a testes/operacoes internas; o HTTP usa TIME do Redis. */
+    public function publish(array $identity, array $request, array $policy, array $credit, ?int $clock = null, bool $initializing = false): array
+    {
+        self::identityKey($identity);
+        $identity['peer_id'] = strtolower($identity['peer_id']);
+        $redis = Redis::connection('announce');
+        $keys = $this->keys($identity);
+        $member = self::identityKey($identity);
+        $ready = $initializing ? '0' : '1';
+
+        for ($attempt = 0; $attempt < 16; $attempt++) {
+            $read = $redis->eval(<<<'LUA'
+if redis.call('HGET', KEYS[7], 'owner_id') ~= ARGV[1] or redis.call('HGET', KEYS[7], 'ready') ~= ARGV[2] or redis.call('GET', KEYS[8]) ~= ARGV[1] then return {'unavailable'} end
+if redis.call('SISMEMBER', KEYS[9], ARGV[4]) == 1 or redis.call('SISMEMBER', KEYS[10], ARGV[5]) == 1 then return {'removed'} end
+local now = tonumber(ARGV[3]) or tonumber(redis.call('TIME')[1])
+return {'ok', redis.call('GET', KEYS[1]) or '', redis.call('GET', KEYS[2]) or '', redis.call('GET', KEYS[3]) or '0', redis.call('ZCOUNT', KEYS[4], '(' .. now, '+inf'), now}
+LUA, \count($keys), ...[...$keys, $this->lease->ownerId, $ready, $clock === null ? '' : (string) $clock, $identity['user_id'], $identity['torrent_id']]);
+
+            if ($read[0] === 'removed') {
+                return ['outcome' => 'rejected', 'reason' => 'removed', 'peer' => null];
+            }
+
+            if ($read[0] !== 'ok') {
+                throw new RuntimeException('Tracker em inicializacao, recuperacao ou sem proprietario ativo.');
+            }
+            [, $oldPeer, $oldHistory, $userVersion, $leechers, $now] = $read;
+            $before = $oldPeer === '' ? null : json_decode($oldPeer, true, flags: JSON_THROW_ON_ERROR);
+
+            if ($oldHistory === '') {
+                // Grupos sem peers nao ocupam o bootstrap inteiro. O primeiro acesso
+                // recupera somente sua referencia; SET NX nao vence outro announce.
+                $persisted = DB::table('history')->where('user_id', $identity['user_id'])->where('torrent_id', $identity['torrent_id'])
+                    ->first(['state_version', 'completed_at', 'swarm_updated_at']);
+                $initial = ['state_version' => (int) ($persisted->state_version ?? 0), 'peers' => [],
+                    'completed'             => ($persisted->completed_at ?? null) !== null, 'last_at' => (int) $now];
+                $redis->eval(<<<'LUA'
+if redis.call('HGET', KEYS[2], 'owner_id') ~= ARGV[1] or redis.call('HGET', KEYS[2], 'ready') ~= ARGV[2] or redis.call('GET', KEYS[3]) ~= ARGV[1] then return 0 end
+redis.call('SET', KEYS[1], ARGV[3], 'NX')
+return 1
+LUA, 3, $keys[1], $keys[6], $keys[7], $this->lease->ownerId, $ready, json_encode($initial, JSON_THROW_ON_ERROR));
+
+                continue;
+            }
+            $history = json_decode($oldHistory, true, flags: JSON_THROW_ON_ERROR);
+            $now = max((int) $now, (int) $history['last_at']);
+            $request['at'] = $now;
+            $result = PeerTransition::apply($before, $request, $policy);
+
+            if ($result['outcome'] !== 'accepted') {
+                return $result;
+            }
+            $state = $result['peer'];
+            $deadline = 0;
+
+            foreach ($history['peers'] as $peerId => $peer) {
+                if ($peer['seeder']) {
+                    $deadline = max($deadline, $peer['expires_at']);
+                }
+
+                if ($peer['expires_at'] <= $now) {
+                    unset($history['peers'][$peerId]);
+                }
+            }
+            $wasMember = isset($history['peers'][$identity['peer_id']]);
+
+            if ($state['active'] && !$wasMember && \count($history['peers']) >= (int) $policy['max_peers']) {
+                return ['outcome' => 'rejected', 'reason' => 'peer_limit', 'peer' => $before, 'upload_delta' => '0', 'download_delta' => '0', 'completed_delta' => 0];
+            }
+            $expires = $state['active'] ? max(array_column($state['endpoints'], 'last_announced_at')) + $policy['endpoint_ttl'] : 0;
+            $previousOwnSlot = $before !== null && $before['visible'] && !$before['seeder']
+                && $before['active'] && max(array_column($before['endpoints'], 'last_announced_at')) + $policy['endpoint_ttl'] > $now;
+
+            if ($state['active'] && !$state['seeder'] && ($policy['download_slots'] ?? null) !== null) {
+                $state['visible'] = (bool) ($request['visible'] ?? $before['visible'] ?? true) && (int) $leechers - (int) $previousOwnSlot < $policy['download_slots'];
+            }
+
+            if ($state['active']) {
+                $history['peers'][$identity['peer_id']] = ['seeder' => $state['seeder'], 'expires_at' => $expires];
+            } else {
+                unset($history['peers'][$identity['peer_id']]);
+            }
+            $history['state_version']++;
+            $completed = $result['completed_delta'] && !$history['completed'] ? 1 : 0;
+            $history['completed'] = $history['completed'] || $completed;
+            $seedtime = 0;
+
+            if (($request['kind'] ?? 'announce') !== 'probe') {
+                if ($now - $history['last_at'] <= (int) ($policy['seedtime_max_interval'] ?? 5400)) {
+                    $seedtime = max(0, min($now, $deadline) - $history['last_at']);
+                }
+                $history['last_at'] = $now;
+            }
+            $countsBefore = PeerTransition::counts($before, (bool) $policy['require_connectivity']);
+            $countsAfter = PeerTransition::counts($state, (bool) $policy['require_connectivity']);
+            $counts = [];
+
+            foreach ($countsBefore as $name => $value) {
+                $counts[$name] = $countsAfter[$name] - $value;
+            }
+            $transition = [
+                'schema_version'    => 1, 'generation' => $this->lease->generation, 'identity' => $identity,
+                'operation'         => $request['kind'] ?? 'announce', 'event' => $request['event'] ?? null, 'observed_at' => $now,
+                'family'            => isset($request['ip']) ? EndpointAddress::observed($request['ip'], (bool) ($policy['allow_private_addresses'] ?? false))->family : null,
+                'peer'              => $state, 'history' => $history, 'upload_delta' => $result['upload_delta'], 'download_delta' => $result['download_delta'],
+                'credited_upload'   => Counter::percent($result['upload_delta'], (int) $credit['upload_percent']),
+                'credited_download' => Counter::percent($result['download_delta'], (int) $credit['download_percent']),
+                'immune'            => ($request['kind'] ?? 'announce') === 'announce' ? (bool) $credit['immune'] : null,
+                'counts'            => $counts, 'completed_delta' => $completed, 'seedtime_delta' => $seedtime,
+            ];
+            $accepted = $redis->eval(file_get_contents(__DIR__.'/journal.lua'), \count($keys), ...[...$keys,
+                $this->lease->ownerId, $ready, $oldPeer, $oldHistory, (string) $userVersion,
+                json_encode($state, JSON_THROW_ON_ERROR), json_encode($history, JSON_THROW_ON_ERROR),
+                json_encode($transition, JSON_THROW_ON_ERROR), (int) $policy['max_pending_transitions'], $member,
+                $state['active'] && $state['visible'] && !$state['seeder'] ? $expires : 0,
+                $state['active'] ? min(array_column($state['endpoints'], 'last_announced_at')) + $policy['endpoint_ttl'] : 0,
+                $identity['user_id'], $identity['torrent_id'],
+            ]);
+
+            if ($accepted[0] === 'accepted') {
+                return array_replace($result, ['peer' => $state, 'completed_delta' => $completed, 'transition_id' => $accepted[1]]);
+            }
+
+            if ($accepted[0] !== 'conflict') {
+                if ($accepted[0] === 'removed') {
+                    return ['outcome' => 'rejected', 'reason' => 'removed', 'peer' => null];
+                }
+
+                throw new RuntimeException('Transicao nao registrada: '.$accepted[0]);
+            }
+            usleep(random_int(500, 2000));
+        }
+
+        throw new RuntimeException('Concorrencia excessiva ao registrar a transicao; tente novamente.');
+    }
+}
diff --git a/app/Services/Dualstack/TransitionWriter.php b/app/Services/Dualstack/TransitionWriter.php
