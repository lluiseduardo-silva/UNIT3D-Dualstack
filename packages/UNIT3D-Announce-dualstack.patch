+        let snapshot=serde_json::to_value(coordinator.torrent_snapshot(id)).map_err(|_|StatusCode::INTERNAL_SERVER_ERROR)?;
+        result.as_object_mut().unwrap().extend(snapshot.as_object().unwrap().clone());
+    }
+    Ok(Json(result))
 }
