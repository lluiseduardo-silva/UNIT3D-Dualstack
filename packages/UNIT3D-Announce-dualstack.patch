+        };
+        announce.port = 6882;
+        announce.left = 100;
+        c.publish_at(
+            leecher,
+            Operation::Announce(announce),
+            Credit::default(),
+            None,
+            at - 1,
+            false,
+        )
+        .unwrap();
+    }
+    c.publish_at(
+        Identity {
+            torrent_id: 12002,
+            ..ID
+        },
+        request(4, 1000, Event::Started),
+        Credit::default(),
+        None,
+        at - 1,
+        false,
+    )
+    .unwrap();
+    let request = ListRequest {
+        torrent_id: 12001,
+        user_id: 12006,
+        numwant: 1,
+        seeds: true,
+        leeches: true,
+    };
+    let counts = SwarmCounts {
+        seeders: 1,
+        leechers: 1,
+        seeders_ipv4: 1,
+        seeders_ipv6: 1,
+        leechers_ipv4: 1,
+        leechers_ipv6: 1,
+    };
+    let questions = |pool: MySqlPool| async move {
+        sqlx::query("SHOW GLOBAL STATUS LIKE 'Questions'")
+            .fetch_one(&pool)
+            .await
+            .unwrap()
+            .get::<String, _>(1)
+            .parse::<u64>()
+            .unwrap()
+    };
+    let before = questions(pool.clone()).await;
+    let list = c.select_at(request, at).unwrap();
+    assert_eq!(list.counts, counts);
+    assert_eq!(list.logical_peers, 1);
+    assert_eq!(list.ipv4.len(), 6);
+    assert_eq!(list.ipv6.len(), 18);
+    assert_eq!(&list.ipv4[4..], 6881_u16.to_be_bytes());
+    assert_eq!(&list.ipv6[16..], 6881_u16.to_be_bytes());
+    let mut expected=b"d8:completei1e10:downloadedi0e10:incompletei1e8:intervali1800e12:min intervali1530e5:peers6:".to_vec();
+    expected.extend([192, 0, 2, 30]);
+    expected.extend(6881_u16.to_be_bytes());
+    expected.extend(b"6:peers618:");
+    expected.extend(
+        "2001:db8::30"
+            .parse::<std::net::Ipv6Addr>()
+            .unwrap()
+            .octets(),
+    );
+    expected.extend(6881_u16.to_be_bytes());
+    expected.extend("15:warning message8:conexãoe".as_bytes());
+    assert_eq!(list.encode(0, 1800, 1530, Some("conexão")), expected);
+    for wanted in [0, 1, 2, usize::MAX] {
+        let list = c
+            .select_at(
+                ListRequest {
+                    numwant: wanted,
+                    ..request
+                },
+                at,
+            )
+            .unwrap();
+        assert_eq!(list.counts, counts);
+        assert_eq!(list.logical_peers, wanted.min(2));
+        assert_eq!(list.ipv4.len() + list.ipv6.len(), 24 * list.logical_peers);
+    }
+    let own = c
+        .select_at(
+            ListRequest {
+                user_id: 12001,
+                ..request
+            },
+            at,
+        )
+        .unwrap();
+    assert_eq!(own.counts, counts);
+    assert_eq!(own.logical_peers, 1);
+    assert_eq!(&own.ipv4[4..], 6882_u16.to_be_bytes());
+    let blocked = c
+        .select_at(
+            ListRequest {
+                seeds: false,
+                leeches: false,
+                ..request
+            },
+            at,
+        )
+        .unwrap();
+    assert_eq!(blocked.counts, counts);
+    assert_eq!(blocked.logical_peers, 0);
+    assert_eq!(
+        c.select_at(
+            ListRequest {
+                torrent_id: 987654,
+                ..request
+            },
+            at
+        )
+        .unwrap()
+        .counts,
+        SwarmCounts::default()
+    );
+    assert_eq!(
+        questions(pool.clone()).await - before,
+        1,
+        "Selecao e codificacao nao consultam MySQL"
+    );
+
+    c.shutdown().await.unwrap();
+    assert!(matches!(c.select(request), Err(Error::Unavailable)));
+    let c = Coordinator::open(pool.clone(), settings).await.unwrap();
+    assert_eq!(c.select_at(request, at).unwrap().counts, counts);
+    // Folga para o bootstrap real; a expiracao usa apenas o relogio de ensaio.
+    let expiry = at + 7101;
+    let expired = c.select_at(request, expiry).unwrap();
+    assert_eq!(
+        expired.counts,
+        SwarmCounts {
+            seeders_ipv6: 0,
+            ..counts
+        }
+    );
+    assert_eq!(expired.ipv4.len(), 6);
+    assert!(expired.ipv6.is_empty());
+    assert_eq!(
+        c.peer(ID).unwrap().endpoints.len(),
+        2,
+        "Filtro temporal nao depende de limpeza fisica"
+    );
+    let stop = super::request(4, 1000, Event::Stopped);
+    c.publish_at(ID, stop, Credit::default(), None, expiry + 1, false)
+        .unwrap();
+    assert_eq!(
+        c.select_at(request, expiry + 1).unwrap().counts,
+        SwarmCounts {
+            seeders: 0,
+            seeders_ipv4: 0,
+            seeders_ipv6: 0,
+            ..counts
+        }
+    );
+    c.shutdown().await.unwrap();
+
+    let c = Coordinator::open(
+        pool.clone(),
+        Settings {
+            require_connectivity: true,
+            ..settings
+        },
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        c.select_at(request, expiry + 1).unwrap().counts,
+        SwarmCounts::default()
+    );
+    let peer = c.peer(leecher).unwrap();
+    for (family, connectable) in [(Family::V4, true), (Family::V6, false)] {
+        let endpoint = peer.endpoints.get(family).unwrap();
+        c.publish_at(
+            leecher,
+            Operation::Probe {
+                ip: endpoint.ip,
+                port: endpoint.port,
+                revision: endpoint.revision,
+                connectable,
+            },
+            Credit::default(),
+            None,
+            expiry + 1,
+            false,
+        )
+        .unwrap();
+    }
+    let list = c.select_at(request, expiry + 1).unwrap();
+    assert_eq!(
+        list.counts,
+        SwarmCounts {
+            leechers: 1,
+            leechers_ipv4: 1,
+            ..SwarmCounts::default()
+        }
+    );
+    assert_eq!(list.logical_peers, 1);
+    assert_eq!(list.ipv4.len(), 6);
+    assert!(list.ipv6.is_empty());
+    c.shutdown().await.unwrap();
+
+    // Mais candidatos que vagas: priorizar seeders, preencher com leechers e
+    // manter os dois endpoints do mesmo peer, sem duplicar a amostra.
+    reset(pool).await;
+    let c = Coordinator::open(pool.clone(), settings).await.unwrap();
+    let at = c.now();
+    for offset in 0..5 {
+        for family in [4, 6] {
+            let Operation::Announce(mut announce) = super::request(family, 1000, Event::Started)
+            else {
+                unreachable!()
+            };
+            announce.port = 6881 + offset as u16;
+            announce.left = if offset < 2 { 0 } else { 100 };
+            c.publish_at(
+                Identity {
+                    user_id: 12001 + offset,
+                    ..ID
+                },
+                Operation::Announce(announce),
+                Credit::default(),
+                None,
+                at,
+                false,
+            )
+            .unwrap();
+        }
+    }
+    for _ in 0..64 {
+        let list = c
+            .select_at(
+                ListRequest {
+                    numwant: 3,
+                    ..request
+                },
+                at,
+            )
+            .unwrap();
+        assert_eq!(list.counts.seeders, 2);
+        assert_eq!(list.counts.leechers, 3);
+        assert_eq!(list.logical_peers, 3);
+        let ports4: std::collections::BTreeSet<_> = list
+            .ipv4
+            .chunks_exact(6)
+            .map(|e| u16::from_be_bytes([e[4], e[5]]))
+            .collect();
+        let ports6: std::collections::BTreeSet<_> = list
+            .ipv6
+            .chunks_exact(18)
+            .map(|e| u16::from_be_bytes([e[16], e[17]]))
+            .collect();
+        assert_eq!(ports4.len(), 3);
+        assert_eq!(ports4, ports6);
+        assert!(ports4.contains(&6881) && ports4.contains(&6882));
+        assert_eq!(ports4.range(6883..=6885).count(), 1);
+    }
+    let own = c
+        .select_at(
+            ListRequest {
+                user_id: 12001,
+                numwant: 10,
+                ..request
+            },
+            at,
+        )
+        .unwrap();
+    assert_eq!(own.logical_peers, 4);
+    assert!(
+        !own.ipv4
+            .chunks_exact(6)
+            .any(|e| e[4..] == 6881_u16.to_be_bytes())
+    );
+    c.shutdown().await.unwrap();
+    println!(
+        "PASS selecao por torrent, uniao de peers, numwant 0/1/2, ambos endpoints, payload, bencode, TTL, conectividade e restart sem SQL na leitura"
+    );
+}
diff --git a/tests/support/dualstack_retention.rs b/tests/support/dualstack_retention.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5fc85a27b92245b1d73ce381083423455b65c589
--- /dev/null
+++ b/tests/support/dualstack_retention.rs
@@ -0,0 +1,224 @@
+use super::*;
+
+fn inactive(c: &Coordinator, id: Identity, at: u64) {
+    let Operation::Announce(mut first) = request(4, 1000, Event::Started) else {
+        unreachable!()
+    };
+    first.left = 100;
+    c.publish_at(
+        id,
+        Operation::Announce(first),
+        Credit::default(),
+        None,
+        at,
+        false,
+    )
+    .unwrap();
+    c.publish_at(
+        id,
+        request(4, 1100, Event::Completed),
+        Credit::default(),
+        None,
+        at + 1,
+        false,
+    )
+    .unwrap();
+    c.publish_at(
+        id,
+        request(4, 1100, Event::Stopped),
+        Credit::default(),
+        None,
+        at + 2,
+        false,
+    )
+    .unwrap();
+}
+
+pub async fn run(pool: &MySqlPool, settings: Settings) {
+    let settings = Settings {
+        inactive_retention: 7200,
+        batch_size: 1,
+        ..settings
+    };
+    reset(pool).await;
+    let c = Coordinator::open(pool.clone(), settings).await.unwrap();
+    let old = c.now() - 8000;
+    inactive(&c, ID, old);
+    assert_eq!(
+        c.retire().await.unwrap(),
+        0,
+        "Transicoes pendentes nao podem ser apagadas"
+    );
+    while c.backlog() > 0 {
+        c.flush().await.unwrap();
+    }
+    let second = Identity {
+        peer_id: [b'2'; 20],
+        ..ID
+    };
+    let recent = Identity {
+        peer_id: [b'3'; 20],
+        ..ID
+    };
+    let active = Identity {
+        peer_id: [b'4'; 20],
+        ..ID
+    };
+    inactive(&c, second, old + 3);
+    inactive(&c, recent, c.now());
+    c.publish(
+        active,
+        request(6, 1000, Event::Started),
+        Credit::default(),
+        None,
+    )
+    .unwrap();
+    while c.backlog() > 0 {
+        c.flush().await.unwrap();
+    }
+    assert_eq!(
+        c.retire().await.unwrap(),
+        1,
+        "Retencao respeita limite do lote"
+    );
+    assert!(c.peer(ID).is_none());
+    assert_eq!(c.retire().await.unwrap(), 1);
+    assert_eq!(c.retire().await.unwrap(), 0);
+    assert_eq!(count(pool, "peers").await, 2);
+    assert!(c.peer(recent).is_some() && c.peer(active).is_some());
+    assert_eq!(credit(pool).await, 300);
+    assert_eq!(count(pool, "history").await, 1);
+    let result = c
+        .publish(ID, request(4, 50, Event::Started), Credit::default(), None)
+        .unwrap();
+    assert_eq!(
+        (result.upload_delta, result.peer.unwrap().state_version),
+        (0, 1)
+    );
+    c.publish(ID, request(6, 50, Event::Started), Credit::default(), None)
+        .unwrap();
+    c.publish(
+        ID,
+        request(6, 60, Event::Completed),
+        Credit::default(),
+        None,
+    )
+    .unwrap();
+    c.shutdown().await.unwrap();
+    assert_eq!(credit(pool).await, 310);
+    assert_eq!(
+        sqlx::query_scalar::<_, i32>("SELECT times_completed FROM torrents WHERE id=12001")
+            .fetch_one(pool)
+            .await
+            .unwrap(),
+        1
+    );
+    let c = Coordinator::open(pool.clone(), settings).await.unwrap();
+    assert_eq!(c.peer(ID).unwrap().uploaded, 60);
+    assert!(c.peer(second).is_none());
+    c.shutdown().await.unwrap();
+    println!(
+        "PASS retencao somente confirmada, lote limitado, preserva recente/ativo/historico e reconexao sem duplicar credito ou conclusao"
+    );
+
+    reset(pool).await;
+    let c = Arc::new(Coordinator::open(pool.clone(), settings).await.unwrap());
+    inactive(&c, ID, c.now() - 8000);
+    while c.backlog() > 0 {
+        c.flush().await.unwrap();
+    }
+    let mut blocker = pool.begin().await.unwrap();
+    sqlx::query("SELECT user_id FROM peers WHERE user_id=12001 FOR UPDATE")
+        .fetch_all(&mut *blocker)
+        .await
+        .unwrap();
+    let retire = {
+        let c = c.clone();
+        tokio::spawn(async move { c.retire().await })
+    };
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while !c.is_retiring(ID) {
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(matches!(
+        c.publish(
+            ID,
+            request(4, 2000, Event::Started),
+            Credit::default(),
+            None
+        ),
+        Err(Error::Unavailable)
+    ));
+    c.publish(
+        second,
+        request(6, 1000, Event::Started),
+        Credit::default(),
+        None,
+    )
+    .unwrap();
+    assert_eq!(c.peer(ID).unwrap().uploaded, 1100);
+    assert_eq!(credit(pool).await, 100);
+    blocker.rollback().await.unwrap();
+    assert_eq!(retire.await.unwrap().unwrap(), 1);
+    c.publish(
+        ID,
+        request(4, 2000, Event::Started),
+        Credit::default(),
+        None,
+    )
+    .unwrap();
+    c.shutdown().await.unwrap();
+    assert_eq!(credit(pool).await, 100);
+    assert_eq!(count(pool, "peers").await, 2);
+    println!(
+        "PASS retencao bloqueada no SQL recusa somente a identidade reservada e preserva announces de outros peers"
+    );
+
+    reset(pool).await;
+    let c = Arc::new(Coordinator::open(pool.clone(), settings).await.unwrap());
+    inactive(&c, ID, c.now() - 8000);
+    while c.backlog() > 0 {
+        c.flush().await.unwrap();
+    }
+    let mut blocker = pool.begin().await.unwrap();
+    sqlx::query("SELECT user_id FROM peers WHERE user_id=12001 FOR UPDATE")
+        .fetch_all(&mut *blocker)
+        .await
+        .unwrap();
+    let retire = {
+        let c = c.clone();
+        tokio::spawn(async move { c.retire().await })
+    };
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while !c.is_retiring(ID) {
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .unwrap();
+    retire.abort();
+    assert!(retire.await.unwrap_err().is_cancelled());
+    assert!(matches!(
+        c.publish(
+            second,
+            request(4, 2000, Event::Started),
+            Credit::default(),
+            None
+        ),
+        Err(Error::Unavailable)
+    ));
+    blocker.rollback().await.unwrap();
+    c.shutdown().await.unwrap();
+    assert_eq!(count(pool, "peers").await, 1);
+    assert_eq!(credit(pool).await, 100);
+    let restored = Coordinator::open(pool.clone(), settings).await.unwrap();
+    assert_eq!(restored.retire().await.unwrap(), 1);
+    restored.shutdown().await.unwrap();
+    assert_eq!(credit(pool).await, 100);
+    println!(
+        "PASS cancelamento da retencao fecha entrada, rollback preserva referencia e bootstrap permite concluir limpeza"
+    );
+}
diff --git a/tests/support/dualstack_writer.rs b/tests/support/dualstack_writer.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ac44e319dade79b1811f5fdb909d88f37c6f8488
--- /dev/null
+++ b/tests/support/dualstack_writer.rs
@@ -0,0 +1,37 @@
+use super::*;
+
+pub async fn run(pool:&MySqlPool,settings:Settings) {
+    reset(pool).await;
+    let generation:u64=sqlx::query_scalar("SELECT generation FROM tracker_ownership WHERE id=1").fetch_one(pool).await.unwrap();
+    for batch_size in [0,501] {
+        assert!(matches!(Coordinator::open(pool.clone(),Settings {batch_size,..settings}).await,Err(Error::Configuration)));
+    }
+    assert_eq!(sqlx::query_scalar::<_,u64>("SELECT generation FROM tracker_ownership WHERE id=1").fetch_one(pool).await.unwrap(),generation);
+
+    // Cem transacoes reais: a cadencia antiga exige ~10 s mesmo com fila cheia.
+    let c=Arc::new(Coordinator::open(pool.clone(),Settings {batch_size:1,..settings}).await.unwrap());
+    for n in 0..100 { c.publish(ID,request(if n%2==0 {4} else {6},1000+n,Event::Started),Credit::default(),None).unwrap(); }
+    let (stop_tx,stop_rx)=tokio::sync::watch::channel(false);
+    let worker={let c=c.clone(); tokio::spawn(async move {c.run(stop_rx).await})};
+    let drained=tokio::time::timeout(Duration::from_secs(3),async {
+        while c.backlog()>0 {tokio::time::sleep(Duration::from_millis(5)).await;}
+    }).await;
+    stop_tx.send(true).unwrap();
+    tokio::time::timeout(Duration::from_secs(5),worker).await.unwrap().unwrap().unwrap();
+    assert!(drained.is_ok(),"Backlog cheio ainda limitado pelo timer de 100 ms");
+    assert_eq!(credit(pool).await,99);
+    assert_eq!(count(pool,"peer_ips").await,2);
+    println!("PASS 100 lotes de uma transicao drenados em menos de 3 s, encerramento e credito unico");
+
+    reset(pool).await;
+    let c=Coordinator::open(pool.clone(),Settings {batch_size:500,..settings}).await.unwrap();
+    for n in 0..1001 {c.publish(ID,request(if n%2==0 {4} else {6},1000+n,Event::Started),Credit::default(),None).unwrap();}
+    assert_eq!(c.flush().await.unwrap(),500);
+    assert_eq!(credit(pool).await,499);
+    assert_eq!(c.flush().await.unwrap(),500);
+    assert_eq!(credit(pool).await,999);
+    c.shutdown().await.unwrap();
+    assert_eq!(credit(pool).await,1000);
+    assert_eq!(count(pool,"peer_ips").await,2);
+    println!("PASS lotes 500/500/1 confirmam 1001 versoes sem duplicar credito; limites 0/501 recusados antes da lease");
+}
