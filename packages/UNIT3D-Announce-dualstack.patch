@@ -0,0 +1,88 @@
+//! Retira somente referencias confirmadas. I/O ocorre fora do mutex do swarm.
+use std::{
+    collections::BTreeSet,
+    time::{Duration, Instant},
+};
+
+use super::{
+    coordinator::{Coordinator, Error, Identity},
+    persistence,
+};
+
+// Cancelamento tambem deixa resultado SQL incerto. So um novo bootstrap pode
+// reabrir a entrada; nao reutiliza uma referencia que talvez tenha sido apagada.
+struct Retirement<'a> {
+    coordinator: &'a Coordinator,
+    committed: bool,
+}
+impl Drop for Retirement<'_> {
+    fn drop(&mut self) {
+        if !self.committed {
+            self.coordinator.close_input();
+        }
+    }
+}
+
+impl Coordinator {
+    #[doc(hidden)]
+    pub fn is_retiring(&self, identity: Identity) -> bool {
+        self.state.lock().retiring.contains(&identity)
+    }
+
+    pub async fn retire(&self) -> Result<usize, Error> {
+        self.retire_at(self.now()).await
+    }
+
+    #[doc(hidden)]
+    pub async fn retire_at(&self, now: u64) -> Result<usize, Error> {
+        // Mesmo escritor dos lotes: fila sem a identidade significa SQL confirmado.
+        let _writer = self.writer.lock().await;
+        let cutoff = now.saturating_sub(self.settings.inactive_retention);
+        let candidates = {
+            let mut state = self.state.lock();
+            if !state.ready || Instant::now() >= state.deadline {
+                return Err(Error::Unavailable);
+            }
+            let pending: BTreeSet<_> = state.pending.iter().map(|c| c.identity).collect();
+            let candidates: Vec<_> = state
+                .peers
+                .iter()
+                .filter(|(id, peer)| {
+                    !peer.active
+                        && peer.endpoints.is_empty()
+                        && peer.updated_at < cutoff
+                        && !pending.contains(id)
+                        && !state.retiring.contains(id)
+                })
+                .take(self.settings.batch_size)
+                .map(|(id, peer)| (*id, peer.state_version))
+                .collect();
+            // Somente essas identidades ficam temporariamente indisponiveis.
+            state.retiring.extend(candidates.iter().map(|(id, _)| *id));
+            candidates
+        };
+        if candidates.is_empty() {
+            return Ok(0);
+        }
+        let mut guard = Retirement {
+            coordinator: self,
+            committed: false,
+        };
+        tokio::time::timeout(
+            Duration::from_secs(15),
+            persistence::retire(&self.pool, &self.lease, &candidates, cutoff),
+        )
+        .await
+        .map_err(|_| Error::Timeout("retencao"))??;
+        {
+            let mut state = self.state.lock();
+            for (identity, _) in &candidates {
+                state.peers.remove(identity);
+                state.retiring.remove(identity);
+            }
+            // A versao/conclusao do historico permanece para uma reconexao futura.
+        }
+        guard.committed = true;
+        Ok(candidates.len())
+    }
+}
diff --git a/src/dualstack/runtime.rs b/src/dualstack/runtime.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b7c057b16a203234fa5d711a872a25556667a9a8
--- /dev/null
+++ b/src/dualstack/runtime.rs
@@ -0,0 +1,135 @@
+//! Um escritor supervisionado: renovacao nunca disputa o fence do proprio lote.
+use std::{future::Future, sync::atomic::Ordering, time::{Duration, Instant}};
+use tokio::sync::watch;
+
+use super::coordinator::{Coordinator, Error};
+
+const RECOVERY_LIMIT: Duration = Duration::from_secs(120);
+const RENEW_INTERVAL: Duration = Duration::from_secs(5);
+const FLUSH_INTERVAL: Duration = Duration::from_millis(100);
+
+// Estes erros permitem tentar a MESMA geracao. Unavailable/Version nunca permitem.
+fn transient(error: &Error) -> bool {
+    error.retryable() || matches!(error, Error::Timeout("renovacao da lease"))
+}
+
+/// Fechar entrada nao cancela SQL/commit. A future conserva seu proprio timeout.
+async fn observe<T>(c: &Coordinator, stop: &mut watch::Receiver<bool>, work: impl Future<Output=Result<T,Error>>) -> Result<T,Error> {
+    let deadline=c.state.lock().deadline;
+    tokio::pin!(work);
+    tokio::select! {
+        result=&mut work => result,
+        _=tokio::time::sleep_until(deadline.into()) => {
+            c.pause_input();
+            work.await
+        },
+        _=stop.changed() => {
+            c.close_input();
+            work.await
+        },
+    }
+}
+
+pub(super) async fn run(c: &Coordinator, mut stop: watch::Receiver<bool>) -> Result<(),Error> {
+    let mut renew_at=Instant::now();
+    let mut flush_at=Instant::now();
+    let mut expire_at=Instant::now();
+    let mut delete_at=Instant::now();
+    let mut retire_at=Instant::now();
+    let mut burst=Instant::now();
+    let mut phase=0;
+    let mut recovering: Option<Instant>=None;
+    let mut stopping: Option<Instant>=None;
+    loop {
+        if *stop.borrow_and_update() || stop.has_changed().is_err() { c.close_input(); }
+        let closed=c.input_closed.load(Ordering::Relaxed);
+        if closed { stopping.get_or_insert_with(Instant::now); }
+        if stopping.is_some_and(|at| at.elapsed()>=RECOVERY_LIMIT) { return Err(Error::Timeout("encerramento")); }
+        if recovering.is_some_and(|at| at.elapsed()>=RECOVERY_LIMIT) { return Err(Error::Timeout("recuperacao")); }
+        // Inclui o watchdog local vencido enquanto SQL estava em andamento.
+        let paused={let state=c.state.lock(); !state.ready || Instant::now()>=state.deadline};
+        if paused && !closed && recovering.is_none() {
+            c.pause_input();
+            recovering=Some(Instant::now());
+            renew_at=Instant::now();
+            tracing::warn!(generation=c.generation(), pending=c.backlog(), "Persistencia pausada; aguardando confirmacao da mesma lease");
+        }
+        if Instant::now()>=renew_at {
+            match observe(c,&mut stop,c.renew()).await {
+                Ok(()) => renew_at=Instant::now()+RENEW_INTERVAL,
+                Err(error) if transient(&error) => {
+                    c.pause_input();
+                    recovering.get_or_insert_with(Instant::now);
+                    c.record_retry(&error);
+                    tracing::warn!(generation=c.generation(), pending=c.backlog(), error=%error, "Renovacao transitoria; entrada permanece fechada");
+                    tokio::time::sleep(Duration::from_millis(200)).await;
+                    continue;
+                },
+                Err(error) => return Err(error),
+            }
+        }
+        if c.input_closed.load(Ordering::Relaxed) { stopping.get_or_insert_with(Instant::now); }
+        if recovering.is_some() && c.backlog()==0 && stopping.is_none() {
+            let mut state=c.state.lock();
+            // close_input e reabertura usam o mesmo mutex: parada nunca e revertida.
+            if !c.input_closed.load(Ordering::Relaxed) && Instant::now()<state.deadline {
+                state.ready=true;
+                recovering=None;
+                tracing::info!(generation=c.generation(), "Persistencia recuperada; journal drenado e entrada reaberta");
+            }
+        }
+        if stopping.is_some() && c.backlog()==0 {
+            if observe(c,&mut stop,c.remove_deleted()).await? { continue; }
+            return observe(c,&mut stop,c.lease.release(&c.pool)).await;
+        }
+        if recovering.is_some() || stopping.is_some() { phase=0; }
+        match phase {
+            0..=7 => {
+                if recovering.is_none() && stopping.is_none() && c.backlog()<c.settings.batch_size && Instant::now()<flush_at {
+                    tokio::select! {
+                        _=tokio::time::sleep_until(flush_at.min(renew_at).into()) => {},
+                        _=stop.changed() => c.close_input(),
+                    }
+                    continue;
+                }
+                if phase==0 { burst=Instant::now(); }
+                match observe(c,&mut stop,c.flush_once()).await {
+                    Ok(_) => {},
+                    Err(error) if transient(&error) => {
+                        c.pause_input();
+                        recovering.get_or_insert_with(Instant::now);
+                        // UPDATE da lease e uma barreira para qualquer commit incerto
+                        // que ainda mantenha o fence S. Depois dele, replay e idempotente.
+                        renew_at=Instant::now();
+                        c.record_retry(&error);
+                        tracing::warn!(generation=c.generation(), pending=c.backlog(), error=%error, "Lote pendente; confirmando propriedade antes do retry");
+                        tokio::time::sleep(Duration::from_millis(200)).await;
+                        continue;
+                    },
+                    Err(error) => return Err(error),
+                }
+                flush_at=Instant::now()+FLUSH_INTERVAL;
+                phase=if c.backlog()<c.settings.batch_size || burst.elapsed()>=FLUSH_INTERVAL {8} else {phase+1};
+                tokio::task::yield_now().await;
+            },
+            8 => {
+                if Instant::now()>=expire_at {
+                    let count=c.expire()?;
+                    if count<c.settings.batch_size.min(c.settings.max_pending) { expire_at=Instant::now()+Duration::from_secs(60); }
+                }
+                phase=9;
+            },
+            9 => {
+                if Instant::now()>=delete_at && !observe(c,&mut stop,c.remove_deleted()).await? { delete_at=Instant::now()+RENEW_INTERVAL; }
+                phase=10;
+            },
+            _ => {
+                if Instant::now()>=retire_at {
+                    let count=observe(c,&mut stop,c.retire()).await?;
+                    if count<c.settings.batch_size { retire_at=Instant::now()+Duration::from_secs(60); }
+                }
+                phase=0;
+            },
+        }
+    }
+}
diff --git a/src/dualstack_network.rs b/src/dualstack_network.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5a0b5006a82e001e9f06051938f0a5b926bddbd7
--- /dev/null
+++ b/src/dualstack_network.rs
@@ -0,0 +1,164 @@
+use indexmap::IndexMap;
+use parking_lot::Mutex;
+use std::{
+    net::{IpAddr, SocketAddr},
+    str::FromStr,
+    time::{Duration, Instant},
+};
+use tokio::{net::TcpStream, sync::Semaphore};
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TrustedNetwork {
+    ip: IpAddr,
+    prefix: u32,
+}
+
+impl FromStr for TrustedNetwork {
+    type Err = &'static str;
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        let (address, prefix) = value
+            .split_once('/')
+            .map_or((value, None), |(a, p)| (a, Some(p)));
+        let ip: IpAddr = address.parse().map_err(|_| "Proxy invalido")?;
+        let width = if ip.is_ipv4() { 32 } else { 128 };
+        let prefix = prefix
+            .map(str::parse::<u32>)
+            .transpose()
+            .map_err(|_| "Prefixo invalido")?
+            .unwrap_or(width);
+        if prefix > width {
+            return Err("Prefixo invalido");
+        }
+        Ok(Self { ip, prefix })
+    }
+}
+
+impl TrustedNetwork {
+    pub fn contains(&self, ip: IpAddr) -> bool {
+        match (self.ip, ip) {
+            (IpAddr::V4(net), IpAddr::V4(ip)) => {
+                self.prefix == 0
+                    || u32::from(net) >> (32 - self.prefix) == u32::from(ip) >> (32 - self.prefix)
+            }
+            (IpAddr::V6(net), IpAddr::V6(ip)) => {
+                self.prefix == 0
+                    || u128::from(net) >> (128 - self.prefix)
+                        == u128::from(ip) >> (128 - self.prefix)
+            }
+            (IpAddr::V4(_), IpAddr::V6(ip)) => ip
+                .to_ipv4_mapped()
+                .is_some_and(|ip| self.contains(IpAddr::V4(ip))),
+            _ => false,
+        }
+    }
+}
+
+/// Cache limitado e no maximo 128 conexoes em voo, sem espera na fila de probes.
+pub struct ProbeCache {
+    cache: Mutex<IndexMap<SocketAddr, (Instant, bool)>>,
+    slots: Semaphore,
+}
+
+impl Default for ProbeCache {
+    fn default() -> Self {
+        Self {
+            cache: Mutex::new(IndexMap::new()),
+            slots: Semaphore::new(128),
+        }
+    }
+}
+
+impl ProbeCache {
+    pub async fn check(&self, address: SocketAddr, capacity: usize, ttl: Duration) -> Option<bool> {
+        let cached = {
+            let mut cache = self.cache.lock();
+            while cache.len() > capacity {
+                cache.swap_remove_index(0);
+            }
+            cache.get(&address).copied()
+        };
+        if let Some((expires, value)) = cached {
+            if expires > Instant::now() {
+                return Some(value);
+            }
+        }
+        let _permit = self.slots.try_acquire().ok()?;
+        let result = tokio::time::timeout(Duration::from_millis(500), TcpStream::connect(address))
+            .await
+            .is_ok_and(|connection| connection.is_ok());
+        let mut cache = self.cache.lock();
+        cache.swap_remove(&address);
+        while capacity > 0 && cache.len() >= capacity {
+            cache.swap_remove_index(0);
+        }
+        if capacity > 0 {
+            cache.insert(address, (Instant::now() + ttl, result));
+        }
+        Some(result)
+    }
+
+    pub fn expire(&self) {
+        self.cache
+            .lock()
+            .retain(|_, (expires, _)| *expires > Instant::now());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn proxies_explicit_and_family_scoped() {
+        let v4: TrustedNetwork = "172.29.92.0/24".parse().unwrap();
+        assert!(v4.contains("172.29.92.10".parse().unwrap()));
+        assert!(v4.contains("::ffff:172.29.92.10".parse().unwrap()));
+        assert!(!v4.contains("172.29.93.10".parse().unwrap()));
+        let v6: TrustedNetwork = "fd42:756e:6974:92::/64".parse().unwrap();
+        assert!(v6.contains("fd42:756e:6974:92::10".parse().unwrap()));
+        assert!(!v6.contains("fd42:756e:6974:93::10".parse().unwrap()));
+        for bad in ["*", "172.29.92.10/33", "::1/129", "::1/-1", ""] {
+            assert!(bad.parse::<TrustedNetwork>().is_err());
+        }
+    }
+
+    #[tokio::test]
+    async fn connectivity_cache_is_bounded_and_expires() {
+        let cache = ProbeCache::default();
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        assert_eq!(
+            cache.check(address, 2, Duration::from_millis(1)).await,
+            Some(true)
+        );
+        drop(listener);
+        tokio::time::sleep(Duration::from_millis(5)).await;
+        assert_eq!(
+            cache.check(address, 2, Duration::from_secs(60)).await,
+            Some(false)
+        );
+        for port in 1..=6 {
+            cache
+                .check(
+                    SocketAddr::from(([127, 0, 0, 1], port)),
+                    2,
+                    Duration::from_secs(60),
+                )
+                .await;
+            assert!(cache.cache.lock().len() <= 2);
+        }
+        cache.check(address, 1, Duration::from_secs(60)).await;
+        assert_eq!(cache.cache.lock().len(), 1);
+        // Ocupacao nao abre uma fila auxiliar sem limite.
+        let _all = cache.slots.acquire_many(128).await.unwrap();
+        assert_eq!(
+            cache
+                .check(
+                    SocketAddr::from(([127, 0, 0, 1], 65534)),
+                    1,
+                    Duration::from_secs(60)
+                )
+                .await,
+            None
+        );
+    }
+}
