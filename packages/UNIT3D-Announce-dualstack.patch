new file mode 100644
index 0000000000000000000000000000000000000000..aac9804cb43d64a935d65acfa2e0a3e366fb3e70
--- /dev/null
+++ b/src/dualstack/deletion.rs
@@ -0,0 +1,267 @@
+//! Remocao administrativa duravel, depois de confirmar o journal anterior ao fence.
+use super::{
+    coordinator::{Coordinator, Error, Identity},
+    persistence,
+};
+use sqlx::{MySql, QueryBuilder, Row};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    time::Duration,
+};
+
+struct Removal<'a> {
+    coordinator: &'a Coordinator,
+    completed: bool,
+}
+impl Drop for Removal<'_> {
+    fn drop(&mut self) {
+        if !self.completed {
+            self.coordinator.close_input();
+        }
+    }
+}
+
+impl Coordinator {
+    pub fn block_deleted_user(&self, id: u32) {
+        self.state.lock().deleted_users.insert(id);
+    }
+    pub fn block_deleted_torrent(&self, id: u32) {
+        self.state.lock().deleted_torrents.insert(id);
+    }
+
+    pub async fn remove_deleted(&self) -> Result<bool, Error> {
+        let mut guard = Removal {
+            coordinator: self,
+            completed: false,
+        };
+        let result = tokio::time::timeout(Duration::from_secs(120), self.remove_deleted_inner())
+            .await
+            .map_err(|_| Error::Timeout("remocao"))??;
+        guard.completed = true;
+        Ok(result)
+    }
+
+    async fn remove_deleted_inner(&self) -> Result<bool, Error> {
+        for (table, column) in [("users", "user_id"), ("torrents", "torrent_id")] {
+            let id=sqlx::query_scalar::<_,u32>(&format!("SELECT id FROM {table} WHERE deleted_at IS NOT NULL AND tracker_removal_state<2 ORDER BY id LIMIT 1"))
+                .fetch_optional(&self.pool).await?;
+            let Some(id) = id else { continue };
+            let barrier = {
+                let mut state = self.state.lock();
+                if table == "users" {
+                    state.deleted_users.insert(id);
+                } else {
+                    state.deleted_torrents.insert(id);
+                }
+                state.sequence
+            };
+            // Novos announces de outros recursos podem continuar; fronteira finita.
+            while self
+                .state
+                .lock()
+                .pending
+                .front()
+                .is_some_and(|c| c.sequence <= barrier)
+            {
+                self.renew().await?;
+                self.flush().await?;
+            }
+            let _writer = self.writer.lock().await;
+            let mut tx = self.pool.begin().await?;
+            self.lease.fence(&mut tx).await?;
+            let deleted = sqlx::query_scalar::<_, i64>(&format!(
+                "SELECT deleted_at IS NOT NULL FROM {table} WHERE id=? FOR UPDATE"
+            ))
+            .bind(id)
+            .fetch_optional(&mut *tx)
+            .await?;
+            if deleted != Some(1) {
+                return Err(Error::StoredState);
+            }
+            sqlx::query(&format!(
+                "UPDATE {table} SET tracker_removal_state=1 WHERE id=? AND tracker_removal_state=0"
+            ))
+            .bind(id)
+            .execute(&mut *tx)
+            .await?;
+            tx.commit().await?;
+            let (peers, groups) = self.delete_entity_batch(table, column, id).await?;
+            let mut state = self.state.lock();
+            for identity in peers {
+                state.peers.remove(&identity);
+                state.retiring.remove(&identity);
+                if let Some(ids) = state.leechers.get_mut(&identity.user_id) {
+                    ids.remove(&identity);
+                    if ids.is_empty() {
+                        state.leechers.remove(&identity.user_id);
+                    }
+                }
+            }
+            for group in groups {
+                state.groups.remove(&group);
+            }
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    async fn delete_entity_batch(
+        &self,
+        table: &str,
+        column: &str,
+        id: u32,
+    ) -> Result<(Vec<Identity>, Vec<(u32, u32)>), Error> {
+        let mut tx = self.pool.begin().await?;
+        self.lease.fence(&mut tx).await?;
+        let rows=sqlx::query(&format!("SELECT user_id,torrent_id,peer_id FROM peers WHERE {column}=? ORDER BY user_id,torrent_id,peer_id LIMIT 200"))
+            .bind(id).fetch_all(&mut *tx).await?;
+        let identities: Vec<_> = rows
+            .iter()
+            .map(|r| {
+                Ok(Identity {
+                    user_id: r.try_get("user_id")?,
+                    torrent_id: r.try_get("torrent_id")?,
+                    peer_id: r
+                        .try_get::<Vec<u8>, _>("peer_id")?
+                        .try_into()
+                        .map_err(|_| Error::StoredState)?,
+                })
+            })
+            .collect::<Result<_, Error>>()?;
+        if identities.is_empty() {
+            let groups:Vec<(u32,u32)>=sqlx::query_as(&format!("SELECT user_id,torrent_id FROM history WHERE {column}=? ORDER BY user_id,torrent_id LIMIT 200 FOR UPDATE"))
+                .bind(id).fetch_all(&mut *tx).await?;
+            if groups.is_empty() {
+                sqlx::query(&format!(
+                    "UPDATE {table} SET tracker_removal_state=2 WHERE id=?"
+                ))
+                .bind(id)
+                .execute(&mut *tx)
+                .await?;
+            } else {
+                let mut q = QueryBuilder::<MySql>::new(
+                    "DELETE FROM history WHERE (user_id,torrent_id) IN (",
+                );
+                {
+                    let mut s = q.separated(",");
+                    for (user, torrent) in &groups {
+                        s.push("(")
+                            .push_bind_unseparated(*user)
+                            .push_unseparated(",")
+                            .push_bind_unseparated(*torrent)
+                            .push_unseparated(")");
+                    }
+                }
+                q.push(")").build().execute(&mut *tx).await?;
+            }
+            tx.commit().await?;
+            return Ok((identities, groups));
+        }
+        for (parent, ids) in [
+            (
+                "users",
+                identities
+                    .iter()
+                    .map(|i| i.user_id)
+                    .collect::<BTreeSet<_>>(),
+            ),
+            (
+                "torrents",
+                identities.iter().map(|i| i.torrent_id).collect(),
+            ),
+        ] {
+            let mut q =
+                QueryBuilder::<MySql>::new(format!("SELECT id FROM {parent} WHERE id IN ("));
+            {
+                let mut s = q.separated(",");
+                for id in ids {
+                    s.push_bind(id);
+                }
+            }
+            q.push(") ORDER BY id FOR UPDATE")
+                .build()
+                .fetch_all(&mut *tx)
+                .await?;
+        }
+        let connectivity = if self.settings.require_connectivity {
+            " AND e.connectable=1"
+        } else {
+            ""
+        };
+        let exists = |family| {
+            format!(
+                "EXISTS(SELECT 1 FROM peer_ips e WHERE e.user_id=p.user_id AND e.torrent_id=p.torrent_id AND e.peer_id=p.peer_id AND e.family={family}{connectivity})"
+            )
+        };
+        let mut q = QueryBuilder::<MySql>::new(format!(
+            "SELECT p.torrent_id,p.active,p.visible,p.seeder,{} AS v4,{} AS v6 FROM peers p WHERE (p.user_id,p.torrent_id,p.peer_id) IN (",
+            exists(4),
+            exists(6)
+        ));
+        persistence::peer_tuples(&mut q, identities.iter().copied());
+        q.push(") ORDER BY p.user_id,p.torrent_id,p.peer_id FOR UPDATE");
+        let mut deltas = BTreeMap::<u32, [i64; 6]>::new();
+        for row in q.build().fetch_all(&mut *tx).await? {
+            let v4 = row.try_get::<i64, _>("v4")? != 0;
+            let v6 = row.try_get::<i64, _>("v6")? != 0;
+            if row.try_get::<bool, _>("active")? && row.try_get::<bool, _>("visible")? && (v4 || v6)
+            {
+                let seed = row.try_get::<bool, _>("seeder")?;
+                let delta = deltas.entry(row.try_get("torrent_id")?).or_default();
+                for (index, value) in [
+                    seed,
+                    !seed,
+                    seed && v4,
+                    seed && v6,
+                    !seed && v4,
+                    !seed && v6,
+                ]
+                .iter()
+                .enumerate()
+                {
+                    delta[index] += i64::from(*value);
+                }
+            }
+        }
+        if !deltas.is_empty() {
+            let mut q = QueryBuilder::<MySql>::new("UPDATE torrents SET ");
+            for (index, field) in [
+                "seeders",
+                "leechers",
+                "seeders_ipv4",
+                "seeders_ipv6",
+                "leechers_ipv4",
+                "leechers_ipv6",
+            ]
+            .iter()
+            .enumerate()
+            {
+                if index != 0 {
+                    q.push(",");
+                }
+                q.push(format!("{field}={field}-CASE id"));
+                for (id, values) in &deltas {
+                    q.push(" WHEN ")
+                        .push_bind(*id)
+                        .push(" THEN ")
+                        .push_bind(values[index]);
+                }
+                q.push(" ELSE 0 END");
+            }
+            q.push(" WHERE id IN (");
+            {
+                let mut s = q.separated(",");
+                for id in deltas.keys() {
+                    s.push_bind(*id);
+                }
+            }
+            q.push(")").build().execute(&mut *tx).await?;
+        }
+        let mut q =
+            QueryBuilder::<MySql>::new("DELETE FROM peers WHERE (user_id,torrent_id,peer_id) IN (");
+        persistence::peer_tuples(&mut q, identities.iter().copied());
+        q.push(")").build().execute(&mut *tx).await?;
+        tx.commit().await?;
+        Ok((identities, vec![]))
+    }
+}
diff --git a/src/dualstack/http.rs b/src/dualstack/http.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7329bd91815a2b07d122ea3db0d7e594da42e675
--- /dev/null
+++ b/src/dualstack/http.rs
@@ -0,0 +1,232 @@
+//! Adaptador HTTP para o coordenador; filas financeiras legadas nao sao usadas.
+use super::*;
+use unit3d_announce::dualstack::{
+    coordinator::{Credit, Error, Identity},
+    peer::{self as logical, Operation, Outcome, Rejection},
+    response::ListRequest,
+};
+
+pub(super) async fn handle(
+    state: &Arc<AppState>,
+    queries: &Announce,
+    user: Result<store::user::User, AnnounceError>,
+    torrent_id: u32,
+    user_agent: &str,
+    ip: IpAddr,
+) -> Result<Vec<u8>, AnnounceError> {
+    let user = user?;
+    let config = state.config.load().clone();
+    let torrent = state
+        .stores
+        .torrents
+        .lock()
+        .get(&torrent_id)
+        .cloned()
+        .ok_or(TorrentNotFound)?;
+    if torrent.is_deleted {
+        return Err(TorrentIsDeleted);
+    }
+    match torrent.status {
+        TorrentStatus::Approved => (),
+        TorrentStatus::Pending => return Err(TorrentIsPendingModeration),
+        TorrentStatus::Rejected => return Err(TorrentIsRejected),
+        TorrentStatus::Postponed => return Err(TorrentIsPostponed),
+        _ => return Err(TorrentUnknownModerationStatus),
+    }
+    if !user.can_download && queries.left != 0 {
+        return Err(DownloadPrivilegesRevoked);
+    }
+    let group = state
+        .stores
+        .groups
+        .read()
+        .get(&user.group_id)
+        .cloned()
+        .ok_or(GroupNotFound)?;
+    if ["banned", "validating", "disabled"].contains(&group.slug.as_str()) {
+        return Err(GroupNotEnabled(group.slug));
+    }
+    let mut upload = config
+        .upload_factor
+        .max(group.upload_factor)
+        .max(torrent.upload_factor);
+    let mut download = config
+        .download_factor
+        .min(group.download_factor)
+        .min(torrent.download_factor);
+    let mut immune = group.is_immune;
+    let overrides = if user.is_lifetime {
+        (
+            config.lifetime_donor_upload_factor_override,
+            config.lifetime_donor_download_factor_override,
+            config.lifetime_donor_immunity_override,
+        )
+    } else if user.is_donor {
+        (
+            config.donor_upload_factor_override,
+            config.donor_download_factor_override,
+            config.donor_immunity_override,
+        )
+    } else {
+        (None, None, None)
+    };
+    if let Some(value) = overrides.0 {
+        upload = upload.max(value);
+    }
+    if let Some(value) = overrides.1 {
+        download = download.min(value);
+    }
+    if let Some(value) = overrides.2 {
+        immune = value;
+    }
+    let featured = state
+        .stores
+        .featured_torrents
+        .read()
+        .contains(&FeaturedTorrent { torrent_id });
+    if featured {
+        upload = 200;
+    }
+    if featured
+        || state
+            .stores
+            .personal_freeleeches
+            .read()
+            .contains(&PersonalFreeleech { user_id: user.id })
+        || state
+            .stores
+            .freeleech_tokens
+            .read()
+            .contains(&FreeleechToken {
+                user_id: user.id,
+                torrent_id,
+            })
+    {
+        download = 0;
+    }
+    let event = match queries.event {
+        Event::Empty => logical::Event::Empty,
+        Event::Started => logical::Event::Started,
+        Event::Stopped => logical::Event::Stopped,
+        Event::Completed => logical::Event::Completed,
+    };
+    let identity = Identity {
+        user_id: user.id,
+        torrent_id,
+        peer_id: queries.peer_id.0,
+    };
+    let coordinator = state.dualstack.as_ref().ok_or(InternalTrackerError)?;
+    let result = coordinator
+        .publish(
+            identity,
+            Operation::Announce(logical::Announce {
+                event,
+                ip,
+                port: queries.port,
+                uploaded: queries.uploaded,
+                downloaded: queries.downloaded,
+                left: queries.left,
+                visible: true,
+                agent: user_agent.into(),
+            }),
+            Credit {
+                upload_percent: upload.into(),
+                download_percent: download.into(),
+                immune,
+            },
+            group.download_slots.map(|n| n as usize),
+        )
+        .map_err(|error| match error {
+            Error::PeerLimit => PeersPerTorrentPerUserLimit(config.max_peers_per_torrent_per_user),
+            Error::Transition(logical::TransitionError::InvalidPort) => InvalidPort,
+            _ => AnnounceError::TrackerUnavailable,
+        })?;
+    if result.reason == Some(Rejection::EndpointLimit) {
+        return Err(AnnounceError::EndpointLimit);
+    }
+    let mut warning = None;
+    let limited = result.reason == Some(Rejection::Interval);
+    if let Some(peer) = result.peer.as_ref() {
+        if !peer.visible {
+            warning = Some("Download slot limit reached");
+        }
+        if result.outcome == Outcome::Accepted
+            && event != logical::Event::Stopped
+            && config.is_connectivity_check_enabled
+        {
+            if let Some(endpoint) = peer.endpoints.get(logical::Family::of(ip)) {
+                if let Some(connectable) = state
+                    .dualstack_probes
+                    .check(
+                        SocketAddr::new(endpoint.ip, endpoint.port),
+                        config.dualstack_connectivity_cache_entries,
+                        std::time::Duration::from_secs(config.dualstack_connectivity_cache_ttl),
+                    )
+                    .await
+                {
+                    // Revisao, IP e porta protegem contra resultados atrasados.
+                    let _ = coordinator.publish(
+                        identity,
+                        Operation::Probe {
+                            ip: endpoint.ip,
+                            port: endpoint.port,
+                            revision: endpoint.revision,
+                            connectable,
+                        },
+                        Credit::default(),
+                        None,
+                    );
+                }
+            }
+        }
+        if config.require_peer_connectivity
+            && !coordinator.peer(identity).is_some_and(|p| p.connectable)
+        {
+            warning = Some("Connectivity issue detected. Enable port-forwarding to resolve.");
+        }
+    }
+    let can_list =
+        queries.event != Event::Stopped && !limited && warning.is_none() && queries.numwant > 0;
+    let (seeds, leeches) = {
+        let mut users = state.stores.users.write();
+        let current = users.get_mut(&user.id).ok_or(UserNotFound)?;
+        let seeds =
+            can_list && queries.left > 0 && current.receive_seed_list_rates.is_under_limit();
+        let leeches = can_list && current.receive_leech_list_rates.is_under_limit();
+        if can_list && queries.left > 0 {
+            current.receive_seed_list_rates.tick();
+        }
+        if can_list {
+            current.receive_leech_list_rates.tick();
+        }
+        (seeds, leeches)
+    };
+    let list = coordinator
+        .select(ListRequest {
+            torrent_id,
+            user_id: user.id,
+            numwant: queries.numwant,
+            seeds,
+            leeches,
+        })
+        .map_err(|_| AnnounceError::TrackerUnavailable)?;
+    let interval = rng().random_range(config.announce_min..=config.announce_max);
+    if config.is_announce_logging_enabled {
+        state.queues.announces.lock().upsert(AnnounceUpdate {
+            user_id: user.id,
+            torrent_id,
+            uploaded: queries.uploaded,
+            downloaded: queries.downloaded,
+            left: queries.left,
+            corrupt: queries.corrupt,
+            peer_id: queries.peer_id,
+            port: queries.port,
+            numwant: queries.numwant.try_into().unwrap_or(u16::MAX),
+            created_at: Utc::now(),
+            event: queries.event,
+            key: queries.key.clone(),
+        });
+    }
+    state.stats.increment_announce_response();
+    Ok(list.encode(list.completed, interval, config.announce_min, warning))
+}
diff --git a/src/dualstack/index.rs b/src/dualstack/index.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0ebec5c63cbf74c99dbcf636a4a7b56925618e3d
--- /dev/null
+++ b/src/dualstack/index.rs
@@ -0,0 +1,182 @@
+//! Estado unico por peer, contiguo por torrent; chaves ordenadas para manutencao.
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    ops::RangeBounds,
+};
+
+use indexmap::IndexMap;
+
+use super::{coordinator::Identity, peer::Peer};
+
+#[derive(Default)]
+pub(crate) struct PeerIndex {
+    torrents: BTreeMap<u32, IndexMap<Identity, Peer>>,
+    identities: BTreeSet<Identity>,
+}
+
+impl PeerIndex {
+    pub fn get(&self, id: &Identity) -> Option<&Peer> {
+        self.torrents.get(&id.torrent_id)?.get(id)
+    }
+
+    /// Usado no bootstrap, antes de abrir o processamento de announces.
+    pub fn get_mut(&mut self, id: &Identity) -> Option<&mut Peer> {
+        self.torrents.get_mut(&id.torrent_id)?.get_mut(id)
+    }
+
+    pub fn insert(&mut self, id: Identity, peer: Peer) -> Option<Peer> {
+        let previous = self
+            .torrents
+            .entry(id.torrent_id)
+            .or_default()
+            .insert(id, peer);
+        if previous.is_none() {
+            self.identities.insert(id);
+        }
+        previous
+    }
+
+    pub fn remove(&mut self, id: &Identity) -> Option<Peer> {
+        let torrent = self.torrents.get_mut(&id.torrent_id)?;
+        let removed = torrent.swap_remove(id)?;
+        self.identities.remove(id);
+        if torrent.is_empty() {
+            self.torrents.remove(&id.torrent_id);
+        }
+        Some(removed)
+    }
+
+    pub fn torrent(&self, id: u32) -> Option<&IndexMap<Identity, Peer>> {
+        self.torrents.get(&id)
+    }
+
+    /// Mantem a ordem user/torrent/peer usada pelos lotes de manutencao.
+    pub fn iter(&self) -> impl Iterator<Item = (&Identity, &Peer)> {
+        self.identities
+            .iter()
+            .map(|id| (id, self.get(id).expect("indice de peer inconsistente")))
+    }
+
+    pub fn range(
+        &self,
+        range: impl RangeBounds<Identity>,
+    ) -> impl Iterator<Item = (&Identity, &Peer)> {
+        self.identities
+            .range(range)
+            .map(|id| (id, self.get(id).expect("indice de peer inconsistente")))
+    }
+
+    pub fn values(&self) -> impl Iterator<Item = &Peer> {
+        self.torrents.values().flat_map(|torrent| torrent.values())
+    }
+
+    pub fn iter_mut(&mut self) -> impl Iterator<Item = (&Identity, &mut Peer)> {
+        self.torrents
+            .values_mut()
+            .flat_map(|torrent| torrent.iter_mut())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::dualstack::peer::{self, Announce, Event, Operation, Policy};
+
+    fn peer(uploaded: u64) -> Peer {
+        peer::apply(
+            None,
+            &Operation::Announce(Announce {
+                event: Event::Started,
+                ip: "192.0.2.1".parse().unwrap(),
+                port: 6881,
+                uploaded,
+                downloaded: 0,
+                left: 0,
+                visible: true,
+                agent: "index-test".into(),
+            }),
+            1000,
+            Policy::default(),
+        )
+        .unwrap()
+        .peer
+        .unwrap()
+    }
+
+    #[test]
+    fn updates_removals_and_bootstrap_mutations_preserve_all_views() {
+        let mut index = PeerIndex::default();
+        let mut expected = BTreeMap::new();
+        // Mesmo peer_id em varios usuarios e torrents; ordem de chegada diferente
+        // da ordem de manutencao e remocoes que movimentam o ultimo slot do torrent.
+        for step in 0..4000_u64 {
+            let id = Identity {
+                user_id: (step % 11) as u32,
+                torrent_id: ((step * 7) % 13) as u32,
+                peer_id: [42; 20],
+            };
+            if step % 5 == 0 {
+                assert_eq!(index.remove(&id), expected.remove(&id));
+            } else {
+                let peer = peer(step);
+                assert_eq!(index.insert(id, peer.clone()), expected.insert(id, peer));
+            }
+            if step % 71 == 0 {
+                assert!(index.iter().eq(expected.iter()));
+                for torrent_id in 0..13 {
+                    let actual: BTreeMap<_, _> = index
+                        .torrent(torrent_id)
+                        .into_iter()
+                        .flat_map(|torrent| torrent.iter())
+                        .collect();
+                    let wanted: BTreeMap<_, _> = expected
+                        .iter()
+                        .filter(|(id, _)| id.torrent_id == torrent_id)
+                        .collect();
+                    assert_eq!(actual, wanted);
+                }
+            }
+        }
+        for (id, peer) in index.iter_mut() {
+            peer.uploaded += 1;
+            expected.get_mut(id).unwrap().uploaded += 1;
+        }
+        for user_id in 0..11 {
+            let first = Identity {
+                user_id,
+                torrent_id: 0,
+                peer_id: [0; 20],
+            };
+            let last = Identity {
+                user_id,
+                torrent_id: u32::MAX,
+                peer_id: [255; 20],
+            };
+            assert!(index.range(first..=last).eq(expected.range(first..=last)));
+        }
+        for id in expected.keys() {
+            assert_eq!(index.get_mut(id).unwrap(), expected.get(id).unwrap());
+            index.remove(id).unwrap();
+        }
+        assert!(index.torrents.is_empty());
+        assert!(index.identities.is_empty());
+        assert_eq!(index.values().count(), 0);
+    }
+
+    #[test]
+    fn repeated_replacement_keeps_one_state_and_one_identity() {
+        let id = Identity {
+            user_id: 1,
+            torrent_id: 1,
+            peer_id: [1; 20],
+        };
+        let mut index = PeerIndex::default();
+        for uploaded in 0..10_000 {
+            index.insert(id, peer(uploaded));
+        }
+        assert_eq!(index.get(&id).unwrap().uploaded, 9999);
+        assert_eq!(index.identities.len(), 1);
+        assert_eq!(index.torrents.len(), 1);
+        assert_eq!(index.torrent(1).unwrap().len(), 1);
+    }
+}
